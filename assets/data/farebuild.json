  },
  {
   "cat": 5,
   "name": "Advance reservations/ticketing",
   "text": "Book and ticket at least 7 days before departure."
  },
  {
   "cat": 6,
   "name": "Minimum stay",
   "text": "The return can't start before the Sunday after the outbound departure."
  },
  {
   "cat": 7,
   "name": "Maximum stay",
   "text": "Return within 3 months."
  },
  {
   "cat": 8,
   "name": "Stopovers",
   "text": "None permitted."
  },
  {
   "cat": 10,
   "name": "Permitted combinations",
   "text": "Half round trip with any other SV fare of the same carrier: this is what lets the low-season and high-season fares share one ticket."
  },
  {
   "cat": 16,
   "name": "Penalties",
