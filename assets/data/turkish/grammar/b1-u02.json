            ["Gelemezdim.", "I couldn't have come.", "It would never have been possible."],
            ["Gelebildim.", "I managed to come.", "I was able to, and I did."],
            ["Gelebilirdim.", "I could have come.", "It was possible, but I didn't."]
          ]
        },
        {
          "type": "examples",
          "items": [
            {
              "tr": "Beni arayabilirdin!",
              "seg": "Beni ara|y|abil|ir|di|n!",
              "en": "You could have called me!"
            },
            {
              "tr": "Daha kötü olabilirdi.",
              "seg": "Daha kötü ol|abil|ir|di.",
              "en": "It could have been worse."
            },
            {
              "tr": "Sensiz bunu yapamazdım.",
              "seg": "Sensiz bunu yap|a|maz|dı|m.",
              "en": "I couldn't have done it without you."
