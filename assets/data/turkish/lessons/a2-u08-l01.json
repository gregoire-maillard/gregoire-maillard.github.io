    {
      "id": "a2-u08-l01-e02",
      "type": "mcq",
      "points": ["gp-comparative", "gp-consonant-assimilation"],
      "question": "How do you say **The train is faster than the bus**?",
      "options": ["Tren otobüsten daha hızlı.", "Tren otobüsden daha hızlı.", "Otobüs trenden daha hızlı.", "Tren otobüse daha hızlı."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*s* is voiceless, so the ablative is *-ten*: *otobüsten*.",
        "2": "This says the **bus** is faster: the ablative marks what you compare **with**.",
        "3": "**Than** is the ablative `-DAn`, not the dative."
      },
      "explain": "*otobüs* + *-ten* (than the bus) + *daha hızlı*."
    },
    {
      "id": "a2-u08-l01-e03",
      "type": "cloze",
      "points": ["gp-comparative"],
      "text": "Bu çanta o çanta___ daha ağır.",
      "en": "This bag is heavier than that bag.",
      "blanks": [
        {
          "accept": ["dan"],
          "reject": [
            {
              "answer": "ya",
              "why": "**Than** is the ablative, not the dative: *o çantadan*."
            },
            {
              "answer": "den",
              "why": "The last vowel of *çanta* is a, a back vowel: *-dan*."
            }
          ]
        }
      ],
      "explain": "*çanta* + *-dan*: **than that bag**."
    },
