      "type": "mcq",
      "points": ["gp-past-di"],
      "question": "You've been walking all day. How do you say **I'm tired**?",
      "options": ["Yoruldum.", "Yoruluyorum.", "Yoruldun."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Yoruluyorum* means **I'm getting tired**, still happening.",
        "2": "*Yoruldun* is **you're tired**."
      },
      "explain": "*Yorulmak* is to get tired; once it has happened, you are tired: *Yoruldum*. *Yorgunum* says the same."
    },
