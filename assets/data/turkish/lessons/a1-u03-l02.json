      "type": "mcq",
      "points": ["gp-personal-pronouns"],
      "question": "You are talking to your new manager. Which word for **you** do you use?",
      "options": ["siz", "sen", "onlar"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*sen* is for friends, family, children and people your own age in relaxed settings.",
        "2": "*onlar* means they."
      },
      "explain": "*siz* is for several people, and for one person you address politely, such as a manager or a stranger."
    },
    {
      "id": "a1-u03-l02-e03",
      "type": "conjugate",
      "points": ["gp-copula-present", "gp-harmony-4way"],
      "base": "doktor",
      "form": "copula-present",
      "label": "*doktor* + **to be**: I am a doctor, you are a doctor…",
      "cells": [
        {
          "p": "ben",
          "accept": ["doktorum"]
        },
        {
          "p": "sen",
          "accept": ["doktorsun"]
