      "type": "mcq",
      "points": ["gp-personal-pronouns"],
      "question": "*Siz mimarsınız.* Who could hear this sentence?",
      "options": ["One person addressed politely, or several people", "Only a close friend", "Only the speaker"],
      "optionsLang": "en",
      "answer": 0,
      "explain": "*siz* and its ending `-sInIz` are both the plural you and the polite you: you are an architect, or you are architects."
    },
    {
      "id": "a1-u03-l02-e08",
      "type": "cloze",
      "points": ["gp-copula-present", "gp-harmony-4way"],
      "text": "Sen garson___, ben polis___.",
      "en": "You are a waiter, I am a police officer.",
      "blanks": [
        {
          "accept": ["sun"],
          "reject": [
            {
              "answer": "sın",
              "why": "The last vowel of *garson* is o, a rounded back vowel, so the ending takes u: *garsonsun*."
            }
          ]
        },
        {
          "accept": ["im"],
          "reject": [
            {
              "answer": "ım",
              "why": "*polis* ends in i, a front vowel, so the ending is *-im*: *polisim*."
            }
          ]
        }
      ],
      "explain": "Each ending copies the last vowel of its word: o → u (*garsonsun*), i → i (*polisim*)."
    },
