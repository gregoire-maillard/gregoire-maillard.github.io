  "exercises": [
    {
      "id": "a1-u05-l03-e01",
      "type": "mcq",
      "points": ["gp-apostrophe"],
      "question": "How do you write **in Istanbul**?",
      "options": ["İstanbul'da", "İstanbulda", "İstanbul'de"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "City names are proper nouns: the suffix follows an apostrophe.",
        "2": "The last vowel of *İstanbul* is u, a back vowel, so the suffix is *-da*."
      },
      "explain": "Proper noun, apostrophe, then *-da*: *İstanbul'da*."
    },
    {
      "id": "a1-u05-l03-e02",
      "type": "cloze",
      "points": ["gp-apostrophe", "gp-locative", "gp-consonant-assimilation"],
      "text": "Elif Ankara'___, Can İzmir'___.",
      "en": "Elif is in Ankara, Can is in Izmir.",
      "blanks": [
        {
          "accept": ["da"],
          "reject": [
            {
              "answer": "de",
              "why": "The last vowel of *Ankara* is a: *-da*."
            },
            {
              "answer": "ta",
              "why": "*Ankara* ends in a vowel, so the d stays d: *Ankara'da*."
            }
          ]
        },
        {
          "accept": ["de"],
          "reject": [
            {
              "answer": "da",
              "why": "The last vowel of *İzmir* is i, a front vowel: *-de*."
            },
            {
              "answer": "te",
              "why": "r is voiced, so the d stays d: *İzmir'de*."
            }
          ]
        }
      ],
      "explain": "The apostrophe doesn't change the rules: *Ankara'da* (a, vowel), *İzmir'de* (i, voiced r)."
    },
    {
      "id": "a1-u05-l03-e03",
