      "type": "mcq",
      "points": ["gp-pronoun-n"],
      "question": "Which word means **in it** or **on it**?",
      "options": ["onda", "oda", "oda da"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Oda* means **room**. *O* adds an n before a case ending: *onda*.",
        "2": "*Oda da* means **the room too**."
      },
      "explain": "*o* + n + *-da*: *onda*. The n keeps it apart from *oda* (room)."
    },
