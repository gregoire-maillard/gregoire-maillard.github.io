  "exercises": [
    {
      "id": "b1-u12-l01-e01",
      "type": "mcq",
      "points": ["gp-direct-speech"],
      "question": "How do you write **“I'm coming,” she said**?",
      "options": ["“Geliyorum.” dedi.", "“Geliyor.” dedi.", "Dedi “Geliyorum.”"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "A quote keeps the speaker's own words: she said *Geliyorum*, **I'm coming**.",
        "2": "*Demek* comes after the quote. To put it first, use *dedi ki*: *Dedi ki: “Geliyorum.”*"
      },
      "explain": "The quote comes first, with its own full stop inside the quotation marks, then *dedi*."
    },
    {
      "id": "b1-u12-l01-e02",
      "type": "cloze",
      "points": ["gp-direct-speech"],
      "text": "Öğretmen “Kitaplarınızı açın.” ___.",
      "en": "The teacher said, “Open your books.”",
      "blanks": [
        {
          "options": ["dedi", "söyledi", "diye"],
          "answer": 0
        }
      ],
      "explain": "*Demek* takes a quote directly. *Söylemek* would need *diye* before it, and *diye* alone doesn't finish the sentence."
    },
    {
      "id": "b1-u12-l01-e03",
      "type": "conjugate",
      "points": ["gp-direct-speech"],
      "base": "demek",
      "form": "present-continuous",
