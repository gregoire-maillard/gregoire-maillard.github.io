      "question": "How do you say **two books**?",
      "options": ["iki kitap", "iki kitaplar", "iki kitabı", "kitap iki"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "After a number the noun stays singular: the number already says there are several.",
        "2": "*Kitabı* is the accusative, or **his book**. Here you need the bare noun.",
        "3": "The number comes before the noun."
      },
      "explain": "Number + singular noun: *iki kitap*."
    },
