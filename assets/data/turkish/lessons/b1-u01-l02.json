{
  "id": "b1-u01-l02",
  "unit": "b1-u01",
  "order": 2,
  "title": "What were you doing?",
  "goal": "Use the past continuous in the negative and in questions: gelmiyordum, geliyor muydun?",
  "points": ["gp-past-continuous", "gp-di-compounds"],
  "intro": {
    "text": "The negative keeps `-mA` inside the verb: *gelmiyordum* (I wasn't coming). In a question, `mI` comes after *-yor* and takes the past and the ending: *Geliyor muydun?* (Were you coming?). Compare the simple past, *Geldin mi?*",
    "see": "gp-di-compounds"
  },
