  "exercises": [
    {
      "id": "b1-u01-l02-e01",
      "type": "mcq",
      "points": ["gp-di-compounds"],
      "question": "How do you ask **Were you sleeping?**",
      "options": ["Uyuyor muydun?", "Uyuyordun mu?", "Uyudun mu?", "Uyumuyor muydun?"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "`mI` doesn't go at the end here. After *-yor* it comes first and takes *-du-n*: *uyuyor muydun?*",
        "2": "*Uyudun mu?* is the simple past: **did you sleep?**",
        "3": "*Uyumuyor muydun?* is negative: **weren't you sleeping?**"
      },
      "explain": "Compound tenses put `mI` straight after the tense suffix: *uyuyor* + *mu* + *-ydu* + *-n*."
    },
