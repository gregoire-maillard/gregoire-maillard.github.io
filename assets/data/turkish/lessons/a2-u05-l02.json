  "exercises": [
    {
      "id": "a2-u05-l02-e01",
      "type": "mcq",
      "points": ["gp-ama-inability"],
      "question": "How do you say **I can't come**?",
      "options": ["Gelemem.", "Gelebilmem.", "Gelmem.", "Gelemez."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The negative of *-ebil* is *-eme*, without *bil*: *gelemem*.",
        "2": "*Gelmem* is **I don't come**, **I won't come**: a choice, not an inability.",
        "3": "*Gelemez* is **he** or **she** can't come."
      },
      "explain": "*gel-* + *-e* + *-me* + *-m*: *gelemem*."
    },
    {
      "id": "a2-u05-l02-e02",
      "type": "conjugate",
      "points": ["gp-ama-inability"],
      "base": "gelmek",
      "form": "inability",
      "label": "*gelmek* with **can't**: I can't come, you can't come…",
      "cells": [
        {
          "p": "ben",
          "accept": ["gelemem"]
        },
        {
          "p": "sen",
          "accept": ["gelemezsin"]
        },
        {
          "p": "o",
          "accept": ["gelemez"]
        },
        {
          "p": "biz",
          "accept": ["gelemeyiz"]
        },
        {
          "p": "siz",
          "accept": ["gelemezsiniz"]
        },
        {
          "p": "onlar",
          "accept": ["gelemezler"]
        }
      ],
      "explain": "`-(y)A` + the negative aorist: *-m* for **I**, *-yiz* for **we**, `-z` with the others."
    },
    {
      "id": "a2-u05-l02-e03",
      "type": "cloze",
      "points": ["gp-ama-inability"],
      "text": "Pardon, sesini duy___.",
      "en": "Sorry, I can't hear you.",
      "blanks": [
        {
          "accept": ["amıyorum"],
          "reject": [
            {
              "answer": "abilmiyorum",
              "why": "**Can't** is `-(y)AmA`, without *bil*: *duyamıyorum*."
            },
            {
              "answer": "emiyorum",
              "why": "The last vowel of *duy-* is u, a back vowel: *duyamıyorum*."
            },
            {
              "answer": "muyorum",
              "why": "*Duymuyorum* is **I don't hear**. **I can't hear** needs `-(y)AmA`: *duyamıyorum*."
            }
          ]
        }
      ],
      "explain": "*duy-* + *-a* + *-mıyor* + *-um*: the a of *-ma* narrows to ı before *-yor*, as in *anlamıyorum*."
    },
    {
