    {
      "id": "a2-u05-l02-e09",
      "type": "mcq",
      "points": ["gp-ama-inability", "gp-harmony-exceptions"],
      "question": "A friend invites you, but you are busy. Which answer is right?",
      "options": ["Maalesef gelemem, meşgulüm.", "Maalesef gelemem, meşgulum.", "Maalesef gelebilirim, meşgulüm."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Meşgul* takes front suffixes: its l is a soft l, as in *rol* → *rolü*. So *meşgulüm*.",
        "2": "*Gelebilirim* means **I can come**."
      },
      "explain": "*Gelemem* (I can't come) and *meşgulüm* (I'm busy), with a front ending after the soft l."
    },
