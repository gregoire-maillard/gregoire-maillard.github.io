      "points": ["gp-should-have"],
      "question": "How do you say **You should have come earlier**?",
      "options": ["Daha erken gelmeliydin.", "Daha erken gelmelisin.", "Daha erken gelebilirdin.", "Daha erken gelecektin."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Gelmelisin* is **you should come**, now or later.",
        "2": "*Gelebilirdin* is **you could have come**: possible, not required.",
        "3": "*Gelecektin* is **you were going to come**."
      },
      "explain": "*gel-meli* + buffer y + *-di* + *-n*: **you should have come**."
    },
