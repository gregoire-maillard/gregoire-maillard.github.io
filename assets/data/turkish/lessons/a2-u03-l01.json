      "type": "mcq",
      "points": ["gp-future"],
      "question": "How do you say **I will come**?",
      "options": ["Geleceğim.", "Gelecekim.", "Geldim.", "Geleceksin."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "Before a vowel the k softens to ğ: *geleceğim*.",
        "2": "*Geldim* is the past: **I came**.",
        "3": "*Geleceksin* is **you will come**."
      },
      "explain": "*gel-* + *-ecek* + *-im*, with k → ğ: *geleceğim*."
    },
    {
      "id": "a2-u03-l01-e03",
      "type": "conjugate",
      "points": ["gp-future"],
      "base": "yapmak",
      "form": "future",
      "label": "*yapmak* (to do) in the future: I will do, you will do…",
      "cells": [
        {
          "p": "ben",
          "accept": ["yapacağım"]
        },
        {
          "p": "sen",
          "accept": ["yapacaksın"]
        },
        {
          "p": "o",
          "accept": ["yapacak"]
        },
        {
          "p": "biz",
          "accept": ["yapacağız"]
        },
        {
          "p": "siz",
          "accept": ["yapacaksınız"]
        },
        {
          "p": "onlar",
          "accept": ["yapacaklar"]
        }
      ],
      "explain": "Back vowel a → *-acak*; k → ğ before *-ım* and *-ız*, but not before *-sın*, *-sınız* or *-lar*."
    },
