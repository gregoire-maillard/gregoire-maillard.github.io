      "points": ["gp-used-to"],
      "question": "How do you say **We used to live here**?",
      "options": ["Eskiden burada otururduk.", "Eskiden burada oturuyoruz.", "Eskiden burada otururuz.", "Eskiden burada oturacaktık."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Oturuyoruz* is the present: **we live here**.",
        "2": "*Otururuz* is the plain aorist, **we live**, not a past habit.",
        "3": "*Oturacaktık* means **we were going to live**."
      },
      "explain": "A past habit: aorist *otur-ur* + *-du* + *-k*: *otururduk*."
    },
