          "p": "o",
          "accept": ["yaşında"]
        },
        {
          "p": "biz",
          "accept": ["yaşındayız"]
        },
        {
          "p": "siz",
          "accept": ["yaşındasınız"]
        },
        {
          "p": "onlar",
          "accept": ["yaşındalar", "yaşında"]
        }
      ],
      "explain": "*Yaşında* ends in a, so the endings take back vowels: *-yım, -sın, -yız, -sınız, -lar*."
    },
