    {
      "id": "a1-u11-l02-e02",
      "type": "mcq",
      "points": ["gp-numbers"],
      "question": "How do you say **100**?",
      "options": ["yüz", "bir yüz", "on on", "bin"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "No *bir* before *yüz* or *bin*: 100 is just *yüz*.",
        "2": "Tens don't multiply this way; 100 has its own word.",
        "3": "*Bin* is 1,000."
      },
      "explain": "100 is *yüz* and 1,000 is *bin*; neither takes *bir*."
    },
    {
      "id": "a1-u11-l02-e03",
      "type": "mcq",
      "points": ["gp-numbers"],
      "question": "How do you write *bin dokuz yüz yirmi üç* in digits?",
      "options": ["1923", "1932", "9123"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "*Yirmi üç* is 23, not 32.",
        "2": "*Bin* comes first: one thousand, nine hundred…"
      },
      "explain": "*Bin* (1,000) + *dokuz yüz* (900) + *yirmi üç* (23) = 1923."
    },
    {
      "id": "a1-u11-l02-e04",
      "type": "conjugate",
      "points": ["gp-age-price", "gp-copula-present"],
      "base": "yaşında",
      "form": "copula-present",
      "label": "*yaşında* + **to be**: I am … years old, you are …",
      "cells": [
        {
          "p": "ben",
          "accept": ["yaşındayım"]
        },
        {
          "p": "sen",
          "accept": ["yaşındasın"]
        },
