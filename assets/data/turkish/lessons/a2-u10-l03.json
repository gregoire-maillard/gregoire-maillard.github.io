      "id": "a2-u10-l03-e06",
      "type": "conjugate",
      "points": ["gp-ki-pronoun", "gp-genitive"],
      "base": "ben",
      "form": "pronoun-genitive-ki",
      "label": "The genitive pronouns + `-ki`: **mine, yours, his or hers…**",
      "cells": [
        {
          "p": "ben",
