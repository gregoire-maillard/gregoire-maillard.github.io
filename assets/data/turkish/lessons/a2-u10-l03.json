{
  "id": "a2-u10-l03",
  "unit": "a2-u10",
  "order": 3,
  "title": "Mine and yours",
  "goal": "Describe a noun with a place or a time (masadaki kitap, yarınki toplantı) and say mine and yours (benimki, seninki).",
  "points": ["gp-ki-adjective", "gp-ki-pronoun"],
  "intro": {
    "text": "`-ki` turns a place or a time into an adjective, which goes before the noun: *masadaki kitap* (the book on the table), *yarınki toplantı* (tomorrow's meeting). After a genitive it makes a pronoun: *benimki* (mine), *seninki* (yours). It never harmonizes, except in *bugünkü* and *dünkü*.",
    "see": "gp-ki-adjective"
  },
  "vocab": [
    {
      "tr": "bugünkü",
      "en": "today's",
      "pos": "adj"
    },
    {
      "tr": "dünkü",
      "en": "yesterday's",
      "pos": "adj"
    },
    {
      "tr": "benimki",
      "en": "mine",
      "pos": "pron"
    },
    {
      "tr": "seninki",
      "en": "yours",
      "pos": "pron"
    },
    {
      "tr": "bizimkiler",
      "en": "my family, my folks (casual)",
      "pos": "pron"
    },
    {
      "tr": "fotoğraf makinesi",
      "en": "camera",
      "pos": "noun"
    },
    {
      "tr": "fiyat",
      "en": "price",
      "pos": "noun"
    }
  ],
  "exercises": [
    {
      "id": "a2-u10-l03-e01",
      "type": "mcq",
      "points": ["gp-ki-adjective"],
      "question": "How do you say **the book on the table**?",
      "options": ["masadaki kitap", "kitap masada", "masada kitap", "kitap masadaki"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Kitap masada* is a sentence: **The book is on the table.**",
        "2": "Without `-ki`, *masada* can't describe a noun.",
        "3": "The describing word comes first: *masadaki kitap*."
      },
      "explain": "*masada* + *-ki* makes an adjective, placed before the noun: *masadaki kitap*."
    },
    {
      "id": "a2-u10-l03-e02",
      "type": "cloze",
      "points": ["gp-ki-adjective"],
      "text": "Bugün___ gazeteyi okudun mu?",
      "en": "Have you read today's paper?",
      "blanks": [
        {
          "accept": ["kü"],
          "reject": [
            {
              "answer": "ki",
              "why": "*Bugün* and *dün* are the exceptions: *bugünkü*, *dünkü*."
            },
            {
              "answer": "deki",
              "why": "Time words take `-ki` without the locative: *bugünkü*."
            }
          ]
        }
      ],
      "explain": "*-ki* never harmonizes, except in *bugünkü*, *dünkü* and *öbürkü*."
    },
    {
      "id": "a2-u10-l03-e03",
      "type": "translate",
      "points": ["gp-ki-adjective"],
      "from": "en",
      "prompt": "Tomorrow's meeting is at ten.",
      "accept": [
        "Yarınki toplantı saat onda.",
        "Yarınki toplantı onda.",
        "Yarınki toplantı (saat) 10'da.",
        "Toplantı yarın (saat) [onda|10'da].",
        "Yarın toplantı (saat) [onda|10'da]."
      ],
      "reject": [
        {
          "answer": "Yarınkü toplantı saat onda.",
          "why": "`-ki` doesn't harmonize: *yarınki*. Only *bugünkü* and *dünkü* take ü."
        }
      ]
    },
    {
      "id": "a2-u10-l03-e04",
      "type": "listen",
      "points": ["gp-ki-adjective", "gp-past-copula"],
      "mode": "type",
      "tr": "Dünkü maç çok heyecanlıydı.",
      "en": "Yesterday's match was very exciting."
    },
    {
      "id": "a2-u10-l03-e05",
      "type": "translate",
      "points": ["gp-ki-pronoun"],
      "from": "tr",
      "prompt": "Senin araban kırmızı, benimki mavi.",
      "accept": ["Your car is red, mine is blue.", "Your car is red and mine is blue.", "Your car is red but mine is blue.", "Your car is red, while mine is blue."]
    },
