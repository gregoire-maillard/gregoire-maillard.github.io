      "explain": "Take the genitive (*benim, senin, onun, bizim, sizin, onların*) and add *-ki*, which never changes."
    },
    {
      "id": "a2-u10-l03-e07",
      "type": "morph",
      "points": ["gp-ki-pronoun", "gp-locative", "gp-plural"],
      "base": "ev",
      "gloss": "the people at home",
      "parts": ["ev", "de", "ki", "ler"],
      "distractors": ["da", "kü", "lar"],
      "result": "evdekiler",
      "explain": "*evde* (at home) + *-ki* (the one) + *-ler* (plural). *-ki* doesn't harmonize, and the plural after it follows its i: *-ler*."
    },
    {
      "id": "a2-u10-l03-e08",
      "type": "wordbank",
      "points": ["gp-ki-adjective", "gp-genitive"],
      "from": "en",
      "prompt": "The keys on the table are mine, not yours.",
