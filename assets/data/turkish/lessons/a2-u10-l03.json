    {
      "id": "a2-u10-l03-e09",
      "type": "mcq",
      "points": ["gp-ki-pronoun"],
      "question": "What does *evdekiler* mean?",
      "options": ["the people at home", "the houses", "at home", "from home"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "**The houses** is *evler*.",
        "2": "**At home** is *evde*. `-ki` turns it into **the one(s) at home**.",
        "3": "**From home** is *evden*."
      },
      "explain": "*evde* + *-ki* + *-ler*: **those at home**, the people at home."
    },
    {
      "id": "a2-u10-l03-e10",
      "type": "cloze",
      "points": ["gp-ki-pronoun", "gp-accusative", "gp-abil-uses"],
      "text": "Telefonum çalışmıyor. Senin___ kullanabilir miyim?",
      "en": "My phone isn't working. Can I use yours?",
      "blanks": [
        {
          "accept": ["kini"],
          "reject": [
            {
              "answer": "ki",
              "why": "*Seninki* is a definite object of *kullanmak*: it takes the accusative, after an n: *seninkini*."
            },
            {
              "answer": "kiyi",
              "why": "After `-ki`, the accusative comes after an n, not a y: *seninkini*."
            }
          ]
        }
      ],
      "explain": "*senin* + *-ki* + n + *-i*: *seninkini*, yours as an object."
    },
    {
      "id": "a2-u10-l03-e11",
