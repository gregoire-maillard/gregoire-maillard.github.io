      "en": "How are you (polite)? I'm fine, thanks.",
      "blanks": [
        {
          "accept": ["sınız"],
          "reject": [
            {
              "answer": "siniz",
              "why": "The last vowel of *nasıl* is ı, so the ending is *-sınız*."
            },
            {
              "answer": "sın",
              "why": "*-sın* is for one person you know well. The polite **you** is *-sınız*."
            }
          ]
        }
      ],
      "explain": "The ending for *siz* is `-sInIz`, with ı after *nasıl*: *Nasılsınız?*"
    },
