      "id": "a1-u04-l03-e02",
      "type": "mcq",
      "points": ["gp-question-words"],
      "question": "How do you ask **Who is this?**",
      "options": ["Bu kim?", "Bu kim mi?", "Bu ne?", "Bu nasıl?"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "A question word already makes a question, so it never takes `mI`.",
        "2": "*Bu ne?* asks **what** this is.",
        "3": "*Bu nasıl?* asks **how** this is, or what it is like."
      },
      "explain": "*Kim* means **who**. With a question word, there is no `mI`: *Bu kim?*"
    },
