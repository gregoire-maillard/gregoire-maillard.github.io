    {
      "id": "a1-u08-l03-e10",
      "type": "cloze",
      "points": ["gp-accusative", "gp-buffer-y-cases"],
      "text": "Bu kelime___ hep unutuyorum.",
      "en": "I always forget this word.",
      "blanks": [
        {
          "accept": ["yi"],
          "reject": [
            {
              "answer": "i",
              "why": "*Kelime* ends in a vowel, so the buffer y comes first: *kelimeyi*."
            },
            {
              "answer": "yı",
              "why": "The last vowel of *kelime* is e, a front vowel: *-yi*."
            }
          ]
        }
      ],
      "explain": "With *bu*, the object is definite: *kelime* + *y* + *-i* = *kelimeyi*."
    },
