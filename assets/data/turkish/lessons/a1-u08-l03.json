    {
      "id": "a1-u08-l03-e08",
      "type": "mcq",
      "points": ["gp-pronoun-accusative", "gp-pronoun-n"],
      "question": "What does *Bunu istiyorum* mean?",
      "options": ["I want this one.", "I want one of these.", "I want it here."],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "*Bunu* points at one thing: **this one**, not one of several.",
        "2": "**Here** would be *burada*."
      },
      "explain": "*Bu* + n + *-u*: **this one**, a definite object."
    },
