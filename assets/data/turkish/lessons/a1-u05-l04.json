      "type": "cloze",
      "points": ["gp-locative", "gp-copula-present"],
      "text": "Alo, Can? Nerede___?",
      "en": "Hello, Can? Where are you?",
      "blanks": [
        {
          "accept": ["sin"],
          "reject": [
            {
              "answer": "sın",
              "why": "The last vowel of *nerede* is e, so the ending is *-sin*."
            },
            {
              "answer": "ysin",
              "why": "The buffer y only comes before an ending that starts with a vowel. *-sin* starts with s: *neredesin*."
            }
          ]
        }
      ],
      "explain": "*Nerede* (where) takes the ending of **to be** like any predicate: *Neredesin?*"
    },
