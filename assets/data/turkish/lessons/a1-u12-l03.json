    {
      "id": "a1-u12-l03-e02",
      "type": "mcq",
      "points": ["gp-ile", "gp-buffer-letters"],
      "question": "How do you say **by car**?",
      "options": ["arabayla", "arabala", "arabada", "arabaya"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "After a vowel, `-(y)lA` takes a buffer y: *arabayla*.",
        "2": "*Arabada* means **in the car**.",
        "3": "*Arabaya* means **to the car**."
      },
      "explain": "*Araba* + y + *-la*: *arabayla*. You can also write *araba ile*."
    },
    {
      "id": "a1-u12-l03-e03",
      "type": "translate",
      "points": ["gp-ile"],
      "from": "en",
      "prompt": "I am going to the cinema with my mother.",
      "accept": [
        "Annemle sinemaya gidiyorum.",
        "Annem ile sinemaya gidiyorum.",
        "Sinemaya annemle gidiyorum.",
        "Annemle birlikte sinemaya gidiyorum.",
        "Ben annemle sinemaya gidiyorum."
      ],
      "reject": [
        {
          "answer": "Annemde sinemaya gidiyorum.",
          "why": "*Annemde* means **at my mother's** or **my mother has it**. **With** is `-(y)lA`: *annemle*."
        }
      ]
    },
    {
      "id": "a1-u12-l03-e04",
      "type": "cloze",
      "points": ["gp-ile"],
      "text": "Ben otobüs___ geliyorum, sen?",
      "en": "I'm coming by bus, and you?",
      "blanks": [
        {
          "accept": ["le"],
          "reject": [
            {
              "answer": "la",
              "why": "The last vowel of *otobüs* is ü, a front vowel: *-le*."
            },
            {
              "answer": "yle",
              "why": "*Otobüs* ends in a consonant: no buffer y."
            }
          ]
        }
      ],
      "explain": "`-(y)lA` has only two forms, *-la* and *-le*: *otobüsle*."
    },
    {
      "id": "a1-u12-l03-e05",
