      "points": ["gp-harmony-4way", "gp-copula-present"],
      "question": "How do you say **I am hungry**?",
      "options": ["Açım.", "Açim.", "Açum."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*i* follows the front vowels e and i. The last vowel of *aç* is a, a back vowel.",
        "2": "*u* follows o and u, the back rounded vowels. a is unrounded."
      },
      "explain": "a is back and unrounded, so the suffix takes ı: *aç* + `-Im` = *açım*."
    },
