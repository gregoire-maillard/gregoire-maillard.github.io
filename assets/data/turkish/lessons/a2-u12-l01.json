        ["tuzlu", "salty"],
        ["işsiz", "unemployed"],
        ["parasız", "free of charge"],
        ["bahçeli", "with a garden"]
      ]
    },
    {
      "id": "a2-u12-l01-e02",
      "type": "mcq",
      "points": ["gp-li", "gp-apostrophe"],
      "question": "How do you say **from Istanbul** (a person from Istanbul)?",
      "options": ["İstanbullu", "İstanbul'lu", "İstanbullı", "İstanbulsuz"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "`-lI` makes a new word, so there is no apostrophe: *İstanbullu*.",
        "2": "Four-way harmony: after u, *-lu*.",
        "3": "`-sIz` means **without**."
      },
      "explain": "*İstanbul* + *-lu*: *İstanbullu*, written as one word."
    },
    {
      "id": "a2-u12-l01-e03",
      "type": "cloze",
      "points": ["gp-siz", "gp-accusative"],
      "text": "Çayı şeker___ içiyorum.",
      "en": "I drink my tea without sugar.",
      "blanks": [
        {
          "accept": ["siz"],
          "reject": [
            {
              "answer": "sız",
              "why": "Four-way harmony after e: *şekersiz*."
            },
            {
              "answer": "li",
              "why": "*Şekerli* is **with** sugar. **Without** is `-sIz`: *şekersiz*."
            }
          ]
        }
      ],
      "explain": "*şeker* + *-siz*: **without sugar**."
    },
    {
      "id": "a2-u12-l01-e04",
      "type": "translate",
      "points": ["gp-li"],
      "from": "en",
      "prompt": "A coffee with milk, please.",
      "accept": ["Bir sütlü kahve, lütfen.", "Sütlü bir kahve, lütfen.", "Sütlü kahve, lütfen."],
      "reject": [
        {
          "answer": "Bir sütle kahve, lütfen.",
          "why": "Before a noun, use `-lI`: *sütlü kahve*. *Sütle* only says what you use."
        }
      ]
    },
    {
