      "points": ["gp-li", "gp-ile"],
      "question": "Which phrase means **a sweetened tea**?",
      "options": ["şekerli bir çay", "şekerle bir çay", "şekersiz bir çay"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
