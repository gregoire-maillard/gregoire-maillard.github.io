  "order": 1,
  "title": "With or without sugar",
  "goal": "Describe things and people with -lI (with, from) and -sIz (without): sütlü, şekersiz, İstanbullu, işsiz.",
  "points": ["gp-li", "gp-siz"],
  "intro": {
    "text": "`-lI` means **with** or **from**: *sütlü kahve* (coffee with milk), *İstanbullu* (from Istanbul, no apostrophe). `-sIz` means **without**: *şekersiz çay* (tea without sugar), *işsiz* (unemployed). Both follow four-way harmony.",
    "see": "gp-li"
  },
  "vocab": [
    {
      "tr": "sütlü",
      "en": "with milk",
      "pos": "adj"
    },
    {
      "tr": "şekersiz",
      "en": "without sugar, unsweetened",
      "pos": "adj"
    },
    {
      "tr": "tuzlu",
      "en": "salty, salted",
      "pos": "adj"
    },
    {
      "tr": "işsiz",
      "en": "unemployed, out of work",
      "pos": "adj"
    },
    {
      "tr": "parasız",
      "en": "free (of charge); broke",
      "pos": "adj"
    },
    {
      "tr": "bahçeli",
      "en": "with a garden",
      "pos": "adj"
    },
    {
      "tr": "renkli",
      "en": "colourful, in colour",
      "pos": "adj"
    },
    {
      "tr": "nereli",
      "en": "from where",
      "pos": "adj"
    }
  ],
  "exercises": [
