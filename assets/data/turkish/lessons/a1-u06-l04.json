    {
      "id": "a1-u06-l04-e04",
      "type": "cloze",
      "points": ["gp-present-continuous-uses"],
      "text": "___ çalışıyorum, yarın çalışmıyorum.",
      "en": "I'm working today, I'm not working tomorrow.",
      "blanks": [
        {
          "options": ["Bugün", "Yarın", "Ne zaman"],
          "answer": 0
        }
      ],
      "explain": "*Bugün* (today) and *yarın* (tomorrow) work with the present continuous, as they do with English **I'm working**."
    },
