  "exercises": [
    {
      "id": "a1-u06-l04-e01",
      "type": "mcq",
      "points": ["gp-present-continuous-uses"],
      "question": "Which sentence talks about a plan for tomorrow?",
      "options": ["Yarın geliyorum.", "Şu anda geliyorum.", "Bu aralar çalışıyorum."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Şu anda* means **right now**: I'm on my way.",
        "2": "*Bu aralar* means **these days**: a situation, not a plan."
      },
      "explain": "With *yarın* (tomorrow), `-(I)yor` describes a plan: *Yarın geliyorum*, I'm coming tomorrow."
    },
    {
      "id": "a1-u06-l04-e02",
      "type": "translate",
      "from": "en",
      "points": ["gp-present-continuous-uses", "gp-question-words"],
      "prompt": "What are you doing this evening?",
      "accept": ["Bu akşam ne yapıyorsun?", "Bu akşam ne yapıyorsunuz?", "Sen bu akşam ne yapıyorsun?", "Siz bu akşam ne yapıyorsunuz?"]
    },
