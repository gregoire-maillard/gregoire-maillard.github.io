      "points": ["gp-present-continuous-uses"],
      "question": "What is the most natural English for *Anlıyorum*?",
      "options": ["I understand.", "I am understanding.", "I understood."],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "English rarely says **I am understanding**. Turkish uses `-(I)yor` for states like this, English the simple present.",
        "2": "That is the past, which comes in A2."
      },
      "explain": "Verbs like *anlamak*, *bilmek* and *istemek* take `-(I)yor` in Turkish but the simple present in English: *anlıyorum*, I understand."
