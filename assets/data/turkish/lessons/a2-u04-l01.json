    {
      "id": "a2-u04-l01-e02",
      "type": "mcq",
      "points": ["gp-aorist-forms"],
      "question": "How do you say **I drink tea every morning**?",
      "options": ["Her sabah çay içerim.", "Her sabah çay içirim.", "Her sabah çay içiyor.", "Her sabah çay içtim."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*İç-* has one syllable, so it takes `-Ar`: *içer*. `-Ir` is for longer stems.",
        "2": "*İçiyor* is the present continuous, for **he** or **she**.",
        "3": "*İçtim* is the past: **I drank**."
      },
      "explain": "One syllable and a front vowel: *iç-* + *-er* + *-im* = *içerim*."
    },
    {
      "id": "a2-u04-l01-e03",
      "type": "conjugate",
      "points": ["gp-aorist-forms"],
      "base": "okumak",
      "form": "aorist",
      "label": "*okumak* (to read) in the aorist: I read, you read…",
      "cells": [
        {
          "p": "ben",
          "accept": ["okurum"]
        },
        {
          "p": "sen",
          "accept": ["okursun"]
        },
        {
          "p": "o",
          "accept": ["okur"]
        },
        {
          "p": "biz",
          "accept": ["okuruz"]
        },
        {
          "p": "siz",
          "accept": ["okursunuz"]
        },
        {
          "p": "onlar",
          "accept": ["okurlar"]
        }
      ],
      "explain": "After a vowel the aorist is just `-r`: *oku-* + *-r* + *-um*. The endings follow the u: *okursun*, *okuruz*."
    },
    {
      "id": "a2-u04-l01-e04",
      "type": "cloze",
      "points": ["gp-aorist-forms"],
      "text": "Genellikle saat on birde yat___.",
      "en": "I usually go to bed at eleven.",
      "blanks": [
        {
          "accept": ["arım"],
          "reject": [
            {
              "answer": "ırım",
              "why": "*Yat-* has one syllable, so the aorist is `-Ar`: *yatarım*."
            },
            {
              "answer": "erim",
              "why": "The vowel of *yat-* is a, a back vowel: *-arım*."
            }
          ]
        }
      ],
      "explain": "One syllable → `-Ar`; back a → *-ar*; then *-ım* for **I**: *yatarım*."
    },
