      "question": "What is the negative of *gidecek*?",
      "options": ["gitmeyecek", "gidmeyecek", "gitmiyecek"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The negative suffix starts with a consonant, so *git-* keeps its t: *gitmeyecek*.",
        "2": "In writing, `-mA` keeps its e: *gitmeyecek*."
      },
      "explain": "The stem changes only before a vowel: *gidecek*, but *gitmeyecek*."
