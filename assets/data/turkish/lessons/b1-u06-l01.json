          "reject": [
            {
              "answer": "yen",
              "why": "*İzleyen film* would be **the film that watched**. The film is the object: *izlediğimiz*."
            },
            {
              "answer": "dik",
              "why": "Add the possessive for **we**, and the k softens before its vowel: *izlediğimiz*."
            },
            {
              "answer": "dığımız",
              "why": "Harmony: *izle-* has e, so *-diğimiz*."
            }
          ]
        }
      ],
      "explain": "*izle-diğ-imiz*: `-DIk` + *-imiz* (our), **the film we watched**."
    },
