    {
      "id": "b1-u06-l01-e03",
      "type": "mcq",
      "points": ["gp-participle-dik"],
      "question": "How do you say **the film I saw**?",
      "options": ["gördüğüm film", "gören film", "film gördüğüm", "gördük filmim"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Gören film* would be **the film that saw**. The film is the object, so `-DIk`.",
        "2": "The participle goes before the noun.",
        "3": "The possessive goes on the participle, not on the noun: *gördüğüm film*."
      },
      "explain": "*gör-düğ-üm*: `-DIk` with *-üm* for **I**, then the noun."
    },
    {
      "id": "b1-u06-l01-e04",
      "type": "cloze",
      "points": ["gp-participle-dik"],
      "text": "Dün izle___ film çok komikti.",
      "en": "The film we watched yesterday was very funny.",
