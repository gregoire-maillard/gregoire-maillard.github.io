    {
      "id": "a1-u02-l03-e02",
      "type": "mcq",
      "points": ["gp-bir-indefinite"],
      "question": "How do you say **a red bag**?",
      "options": ["kırmızı bir çanta", "bir çanta kırmızı", "çanta kırmızı bir"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Bir çanta kırmızı* is not a phrase. The adjective comes before the noun.",
        "2": "In Turkish the noun comes last in the phrase."
      },
      "explain": "Adjective, then *bir*, then the noun: *kırmızı bir çanta*."
    },
    {
      "id": "a1-u02-l03-e03",
      "type": "translate",
      "from": "en",
      "points": ["gp-bir-indefinite"],
      "prompt": "This is a new phone.",
      "accept": ["Bu yeni bir telefon."],
      "reject": [
        {
          "answer": "Bu bir yeni telefon.",
          "why": "*bir* goes after the adjective: *yeni bir telefon*. *Bir yeni* sounds like one new phone."
        },
        {
          "answer": "Bu yeni telefon.",
          "why": "Without *bir* this reads as **this is the new phone** or **this new phone**. For **a** new phone, add *bir* after the adjective."
        }
      ]
    },
    {
      "id": "a1-u02-l03-e04",
      "type": "listen",
      "mode": "type",
      "tr": "Kalemler mavi.",
      "en": "The pens are blue."
    },
    {
      "id": "a1-u02-l03-e05",
      "type": "cloze",
      "points": ["gp-plural", "gp-harmony-2way"],
      "text": "Çanta___ büyük, defter___ küçük.",
      "en": "The bags are big, the notebooks are small.",
      "blanks": [
        {
          "accept": ["lar"],
          "reject": [
            {
              "answer": "ler",
              "why": "The last vowel of *çanta* is a, a back vowel: *-lar*."
            }
          ]
        },
        {
          "accept": ["ler"],
          "reject": [
            {
              "answer": "lar",
              "why": "The last vowel of *defter* is e, a front vowel: *-ler*."
            }
          ]
        }
      ],
      "explain": "*çanta* ends in back a → *çantalar*; *defter* ends in front e → *defterler*."
    },
    {
      "id": "a1-u02-l03-e06",
      "type": "translate",
      "from": "tr",
      "points": ["gp-demonstratives"],
      "prompt": "Bunlar ne?",
      "accept": ["What are these?"]
    },
    {
      "id": "a1-u02-l03-e07",
      "type": "mcq",
      "points": ["gp-demonstratives", "gp-plural"],
      "question": "Which one means **these books**?",
      "options": ["bu kitaplar", "bunlar kitaplar"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Bunlar* stands on its own, as in *Bunlar ne?*. Before a noun, use *bu*."
      },
      "explain": "Before a noun, *bu* never changes, even in the plural: *bu kitaplar*."
    },
    {
      "id": "a1-u02-l03-e08",
      "type": "morph",
      "points": ["gp-demonstratives"],
      "base": "bu",
      "gloss": "these (on its own)",
      "parts": ["bu", "nlar"],
      "distractors": ["lar", "nler"],
      "result": "bunlar",
      "explain": "As a pronoun, *bu* takes an extra *n* before the plural: *bunlar*, like *şunlar* and *onlar*. u is back, so *-lar*."
    },
    {
      "id": "a1-u02-l03-e09",
