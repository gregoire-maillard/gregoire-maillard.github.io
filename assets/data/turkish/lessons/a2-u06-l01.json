    {
      "id": "a2-u06-l01-e02",
      "type": "mcq",
      "points": ["gp-meli"],
      "question": "How do you say **You should rest**?",
      "options": ["Dinlenmelisin.", "Dinlenmalısın.", "Dinlenmeliyim.", "Dinleniyorsun."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The last vowel of *dinlen-* is e, a front vowel: *-meli*, then *-sin*.",
        "2": "*Dinlenmeliyim* is **I** should rest.",
        "3": "*Dinleniyorsun* is **you are resting**."
      },
      "explain": "*dinlen-* + *-meli* + *-sin*: *dinlenmelisin*."
    },
    {
      "id": "a2-u06-l01-e03",
      "type": "conjugate",
      "points": ["gp-meli"],
      "base": "gitmek",
      "form": "necessitative",
      "label": "*gitmek* with **must**: I must go, you must go…",
      "cells": [
        {
          "p": "ben",
          "accept": ["gitmeliyim"]
        },
        {
          "p": "sen",
          "accept": ["gitmelisin"]
        },
        {
          "p": "o",
          "accept": ["gitmeli"]
        },
        {
          "p": "biz",
          "accept": ["gitmeliyiz"]
        },
        {
          "p": "siz",
          "accept": ["gitmelisiniz"]
        },
        {
          "p": "onlar",
          "accept": ["gitmeliler"]
        }
      ],
      "explain": "`-mAlI` + type I endings, with a buffer y before *-im* and *-iz*. The t of *git-* stays: `-mAlI` starts with a consonant."
    },
    {
      "id": "a2-u06-l01-e04",
      "type": "cloze",
      "points": ["gp-meli", "gp-possessive-have"],
      "text": "Ateşin var. Doktora git___.",
      "en": "You have a fever. You should go to the doctor.",
      "blanks": [
        {
          "accept": ["melisin"],
          "reject": [
            {
              "answer": "malısın",
              "why": "The vowel of *git-* is i, a front vowel: *-meli*."
            },
            {
              "answer": "meli",
              "why": "*Gitmeli* is for **he** or **she**. For **you**, add *-sin*: *gitmelisin*."
            }
          ]
        }
      ],
      "explain": "*git-* + *-meli* + *-sin*: *gitmelisin*."
    },
