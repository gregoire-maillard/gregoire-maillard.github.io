    {
      "id": "a2-u07-l02-e02",
      "type": "mcq",
      "points": ["gp-imperative-3rd"],
      "question": "Mehmet is tired. How do you say **Let Mehmet rest**?",
      "options": ["Mehmet dinlensin.", "Mehmet dinlensın.", "Mehmet dinlenelim.", "Mehmet dinleniyor."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The last vowel of *dinlen-* is e: four-way harmony gives *-sin*.",
        "2": "*Dinlenelim* is **let's rest**.",
        "3": "*Dinleniyor* means **he is resting**."
      },
      "explain": "*dinlen-* + *-sin*: *Mehmet dinlensin*."
    },
    {
      "id": "a2-u07-l02-e03",
      "type": "conjugate",
      "points": ["gp-imperative-3rd", "gp-optative"],
      "base": "gelmek",
      "form": "optative-imperative-3rd",
      "label": "*gelmek*: **let me come**, **let him come**, **let's come**, **let them come**",
      "cells": [
        {
          "p": "ben",
          "accept": ["geleyim"]
        },
        {
          "p": "o",
          "accept": ["gelsin"]
        },
        {
          "p": "biz",
          "accept": ["gelelim"]
        },
        {
          "p": "onlar",
          "accept": ["gelsinler"]
        }
      ],
      "explain": "The optative for **me** and **us** (*geleyim, gelelim*), the third-person imperative for **him** and **them** (*gelsin, gelsinler*)."
    },
    {
      "id": "a2-u07-l02-e04",
      "type": "cloze",
      "points": ["gp-imperative-3rd", "gp-accusative"],
      "text": "Misafirler geliyor. Çocuklar sofrayı kur___.",
      "en": "The guests are coming. The children can set the table.",
      "blanks": [
        {
          "accept": ["sun", "sunlar"],
          "reject": [
            {
              "answer": "sın",
              "why": "The vowel of *kur-* is u: four-way harmony gives *-sun*."
            },
            {
              "answer": "alım",
              "why": "*Kuralım* is **let's set** the table. For **the children**, use *-sun*."
            }
          ]
        }
      ],
      "explain": "*kur-* + *-sun*: **let the children set the table**. With a plural subject, *-lAr* is optional: *kursun* or *kursunlar*."
    },
