    {
      "id": "a2-u12-l04-e01",
      "type": "mcq",
      "points": ["gp-distributive", "gp-ca", "gp-ci"],
      "question": "What price do they agree on in the end?",
      "context": [
        {
          "who": "Halıcı",
          "tr": "Hoş geldiniz! Buyurun, birer çay içer misiniz?",
          "en": "Welcome! Come in, will you have a tea each?"
        },
        {
          "who": "Selin",
          "tr": "Teşekkürler. Bu renkli halı çok güzel. Kaç lira?",
          "en": "Thank you. This colourful carpet is very beautiful. How much is it?"
        },
        {
          "who": "Halıcı",
          "tr": "Bu eski bir Kayseri halısı, efendim. On bin lira.",
          "en": "This is an old Kayseri carpet, madam. Ten thousand lira."
        },
        {
          "who": "Selin",
          "tr": "Çok pahalı! Biraz indirim yapar mısınız? Bence yedi bin iyi bir fiyat.",
          "en": "That's very expensive! Could you give me a little discount? I think seven thousand is a good price."
        },
        {
          "who": "Halıcı",
          "tr": "Sizin için sekiz bin olsun.",
          "en": "For you, let's say eight thousand."
        },
        {
          "who": "Selin",
          "tr": "Yedi bin beş yüz?",
          "en": "Seven thousand five hundred?"
        },
        {
          "who": "Halıcı",
          "tr": "Anlaştık!",
          "en": "Deal!"
        }
      ],
      "options": ["7,500 lira", "7,000 lira", "8,000 lira", "10,000 lira"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "Seven thousand is Selin's first offer.",
        "2": "Eight thousand is the seller's second price.",
        "3": "Ten thousand is the first price."
      },
      "explain": "*Yedi bin beş yüz? — Anlaştık!*: they agree on 7,500 lira."
    },
