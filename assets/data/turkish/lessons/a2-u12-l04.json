      "blanks": [
        {
          "accept": ["cı"],
          "reject": [
            {
              "answer": "çı",
              "why": "After a vowel, C stays c: *halıcı*."
            },
            {
              "answer": "ci",
              "why": "Four-way harmony after ı: *halıcı*."
            },
            {
              "answer": "cılar",
              "why": "After *çok*, the noun stays singular: *çok halıcı*."
            }
          ]
        }
      ],
      "explain": "*halı* + *-cı*: **carpet seller**. After *çok*, no plural."
    },
