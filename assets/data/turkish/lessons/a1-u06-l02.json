  "exercises": [
    {
      "id": "a1-u06-l02-e01",
      "type": "mcq",
      "points": ["gp-present-continuous"],
      "question": "How do you say **I understand**?",
      "options": ["Anlıyorum.", "Anlayorum.", "Anlaıyorum.", "Anliyorum."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The a at the end of *anla-* doesn't stay before *-yor*: *anlıyorum*.",
        "2": "Only one vowel comes before *-yor*: the stem's a drops and ı takes its place.",
        "3": "The new vowel follows four-way harmony with the vowel before it, the a of *anl-*: ı, not i."
      },
      "explain": "Stems ending in a or e drop that vowel, and `-Iyor` brings its own: *anla-* → *anlıyor*."
    },
    {
      "id": "a1-u06-l02-e02",
      "type": "conjugate",
      "points": ["gp-present-continuous"],
      "base": "beklemek",
      "form": "present-continuous",
      "label": "*beklemek* (to wait): I am waiting, you are waiting…",
      "cells": [
