      "type": "mcq",
      "points": ["gp-present-continuous"],
      "question": "How do you say **I'm leaving**?",
      "options": ["Gidiyorum.", "Gitiyorum.", "Gidyorum."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The t of *git-* becomes d before a vowel: *gidiyorum*.",
        "2": "*Git-* ends in a consonant, so it needs i before *-yor*: *gidiyorum*."
      },
      "explain": "*Gitmek* (to go, to leave) softens its t: *gidiyorum*. *Etmek* does the same: *ediyorum*."
    },
