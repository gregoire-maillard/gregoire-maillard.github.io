    {
      "id": "a1-u07-l02-e01",
      "type": "mcq",
      "points": ["gp-ablative", "gp-consonant-assimilation"],
      "question": "How do you say **from the park**?",
      "options": ["parktan", "parkdan", "parkta", "parka"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "k is voiceless, so the d of `-DAn` becomes t: *parktan*.",
        "2": "*Parkta* means **in the park**; the ablative ends in n.",
        "3": "*Parka* means **to the park**."
      },
      "explain": "Voiceless k and back vowel a: *park* + *-tan* = *parktan*."
    },
    {
      "id": "a1-u07-l02-e02",
      "type": "cloze",
      "points": ["gp-ablative", "gp-consonant-assimilation"],
      "text": "Mehmet iş___ geliyor.",
      "en": "Mehmet is coming from work.",
      "blanks": [
        {
          "accept": ["ten"],
          "reject": [
            {
              "answer": "den",
              "why": "*İş* ends in ş, a voiceless consonant, so the d becomes t: *işten*."
            },
            {
              "answer": "tan",
              "why": "The vowel of *iş* is i, a front vowel: *-ten*."
            },
            {
              "answer": "e",
              "why": "*İşe* means **to work**. Coming **from** work takes the ablative: *işten*."
            }
          ]
        }
      ],
      "hint": "Is ş voiced or voiceless? Is i front or back?",
      "explain": "Voiceless ş and front i: *iş* + *-ten* = *işten*."
    },
