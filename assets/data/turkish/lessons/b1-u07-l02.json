    {
      "id": "b1-u07-l02-e02",
      "type": "morph",
      "points": ["gp-arak"],
      "base": "yürümek",
      "gloss": "on foot, by walking",
      "parts": ["yürü", "yerek"],
      "distractors": ["yarak", "erek", "yünce"],
      "result": "yürüyerek",
      "explain": "After a vowel, `-(y)ArAk` takes the buffer y; *yürü-* has ü, a front vowel, so *-yerek*: *yürüyerek*."
    },
    {
      "id": "b1-u07-l02-e03",
      "type": "cloze",
      "points": ["gp-arak"],
      "text": "Ali her sabah işe yürü___ gidiyor.",
      "en": "Ali goes to work on foot every morning.",
      "blanks": [
        {
          "accept": ["yerek"],
          "reject": [
            {
              "answer": "yarak",
              "why": "Harmony: *yürü-* has ü, a front vowel, so *-yerek*."
            },
            {
              "answer": "erek",
              "why": "After a vowel, add the buffer y: *yürüyerek*."
            }
          ]
        }
      ],
      "explain": "*yürü-y-erek gidiyor*: he goes **by walking**, on foot."
    },
    {
      "id": "b1-u07-l02-e04",
      "type": "mcq",
      "points": ["gp-arak"],
      "question": "*Gülerek cevap verdi.* What does it mean?",
      "options": ["She answered with a laugh.", "She laughed, then she left.", "She answered without laughing."],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "That would be two steps, *gülüp gitti*. `-(y)ArAk` describes how one action was done.",
        "2": "**Without** is `-mAdAn`: *gülmeden*."
      },
      "explain": "*gül-erek*: laughing as she answered."
    },
