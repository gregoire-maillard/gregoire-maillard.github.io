      "en": "month; moon",
      "pos": "noun",
      "card": "fc-0282"
    },
    {
      "tr": "yıl",
      "en": "year",
      "pos": "noun",
      "card": "fc-0132"
    },
    {
      "tr": "geçen",
      "en": "last (as in last week)",
      "pos": "adj"
    },
    {
      "tr": "önce",
      "en": "ago (after a time phrase)",
      "pos": "adv",
      "card": "fc-0069"
    },
    {
      "tr": "henüz",
      "en": "yet (with a negative); just",
      "pos": "adv",
      "card": "fc-0449"
    },
    {
      "tr": "daha",
      "en": "yet (with a negative: not yet)",
      "pos": "adv",
      "card": "fc-0031"
    },
    {
      "tr": "zaten",
      "en": "already; anyway",
      "pos": "adv",
      "card": "fc-0245"
    }
  ],
