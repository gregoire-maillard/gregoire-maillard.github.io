    {
      "id": "a1-u06-l01-e02",
      "type": "mcq",
      "points": ["gp-infinitive-stem"],
      "question": "What is the stem of *yazmak*?",
      "options": ["yaz-", "yazm-", "yazma-", "ya-"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The infinitive ending is `-mAk`, so the m goes too.",
        "2": "*-ma* is part of the infinitive ending `-mAk`.",
        "3": "Only `-mAk` comes off; the z belongs to the stem."
      },
      "explain": "Take `-mAk` off the infinitive: *yazmak* → *yaz-*."
    },
    {
      "id": "a1-u06-l01-e03",
      "type": "conjugate",
      "points": ["gp-present-continuous"],
      "base": "yapmak",
