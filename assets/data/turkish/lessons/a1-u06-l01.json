    {
      "id": "a1-u06-l01-e06",
      "type": "cloze",
      "points": ["gp-present-continuous", "gp-harmony-4way"],
      "text": "Ali mektup yaz___.",
      "en": "Ali is writing a letter.",
      "blanks": [
        {
          "accept": ["ıyor"],
          "reject": [
            {
              "answer": "iyor",
              "why": "The last vowel of *yaz-* is a, so the vowel before *-yor* is ı: *yazıyor*."
            },
            {
              "answer": "yor",
              "why": "*Yaz-* ends in a consonant, so it needs a vowel before *-yor*: *yazıyor*."
            },
            {
              "answer": "ıyör",
              "why": "*-yor* never changes: its o stays o after any vowel."
            }
          ]
        }
      ],
      "hint": "Does *yaz-* end in a vowel or a consonant? What is its last vowel?",
      "explain": "Consonant at the end, so add `-Iyor`; after a, the I is ı: *yazıyor*."
    },
