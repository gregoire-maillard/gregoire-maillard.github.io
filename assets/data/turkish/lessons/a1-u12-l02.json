  "exercises": [
    {
      "id": "a1-u12-l02-e01",
      "type": "mcq",
      "points": ["gp-imperative"],
      "question": "How do you tell a friend **Don't be afraid!**?",
      "options": ["Korkma!", "Korkmayın!", "Korkmuyorsun!", "Korkmak!"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Korkmayın* is for several people, or for someone you'd call *siz*.",
        "2": "*Korkmuyorsun* is a statement: **you aren't afraid**.",
        "3": "*Korkmak* is the dictionary form: **to be afraid**."
      },
      "explain": "Stem + *-ma*: *korkma*."
    },
    {
      "id": "a1-u12-l02-e02",
      "type": "conjugate",
      "points": ["gp-imperative"],
      "base": "gelmek",
      "form": "imperative-negative",
      "label": "*gelmek* (to come), negative imperative: to one friend, then to several people or politely",
      "cells": [
        {
          "p": "sen",
          "accept": ["gelme"]
        },
        {
          "p": "siz",
          "accept": ["gelmeyin"]
        }
      ],
      "explain": "*-me* after the stem. Before `-(y)In`, the vowel of *-me* takes a buffer y: *gelmeyin*."
    },
    {
      "id": "a1-u12-l02-e03",
      "type": "translate",
      "points": ["gp-imperative"],
      "from": "en",
      "prompt": "Don't worry!",
      "accept": ["Merak etme!", "Merak etmeyin!", "Merak etmeyiniz!"],
      "reject": [
        {
          "answer": "Merak etmiyor!",
          "why": "*Etmiyor* is a statement: she isn't worried. A command uses the stem: *merak etme*."
        }
      ]
    },
    {
      "id": "a1-u12-l02-e04",
      "type": "cloze",
      "points": ["gp-imperative", "gp-possessive-have"],
      "text": "Acele et___, zamanımız var.",
      "en": "Don't hurry, we have time.",
      "blanks": [
        {
          "accept": ["me", "meyin"],
          "reject": [
            {
              "answer": "ma",
              "why": "The last vowel of *et-* is e: *-me*."
            },
            {
              "answer": "miyor",
              "why": "*Etmiyor* is a statement. A command is the stem + *-me*: *etme*."
            }
          ]
        }
      ],
      "explain": "Negative imperative: stem + `-mA`. *Et-* has e, so *etme*; politely, *etmeyin*."
    },
    {
      "id": "a1-u12-l02-e05",
      "type": "listen",
      "mode": "type",
      "tr": "Yavaş konuşun, lütfen.",
      "en": "Speak slowly, please."
    },
    {
      "id": "a1-u12-l02-e06",
      "type": "mcq",
      "points": ["gp-imperative"],
      "question": "On a sign: *Lütfen sessiz olunuz.* What does it ask?",
      "options": ["Please be quiet", "Please wait", "Please come in"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "**Please wait** would be *Lütfen bekleyiniz*.",
        "2": "**Come in** would be *Girin* or *Buyurun*."
      },
      "explain": "*Ol-unuz*: the formal `-(y)InIz` form of *olmak*, to be. *Sessiz* means quiet."
    },
