      "type": "mcq",
      "points": ["gp-equative"],
      "question": "How do you say **as tall as me**?",
      "options": ["benim kadar uzun", "ben kadar uzun", "benden kadar uzun", "benden daha uzun"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "After *ben*, the postposition needs the genitive: *benim kadar*.",
        "2": "*Kadar* meaning **as … as** takes no ablative.",
        "3": "*Benden daha uzun* is **taller than me**."
      },
      "explain": "*benim* + *kadar* + adjective: **as tall as me**."
    },
    {
      "id": "a2-u08-l03-e02",
      "type": "cloze",
      "points": ["gp-equative", "gp-genitive"],
      "text": "Ben de sen___ gibi öğretmenim.",
      "en": "I'm a teacher too, like you.",
      "blanks": [
        {
          "accept": ["in"],
          "reject": [
            {
              "answer": "den",
              "why": "*Gibi* doesn't take the ablative: *senin gibi*."
            }
          ]
        }
      ],
      "explain": "*Gibi* after *sen* takes the genitive: *senin gibi*."
    },
    {
      "id": "a2-u08-l03-e03",
