      "question": "What is Murat's job?",
      "options": ["cook", "teacher", "doctor"],
      "optionsLang": "en",
      "answer": 0,
      "explain": "*Aşçıyım*: *aşçı* (cook) + buffer *y* + *-ım*, I am a cook."
    },
    {
      "id": "a1-u03-l04-e05",
      "type": "translate",
      "from": "tr",
      "prompt": "Ayşe Hanım evli, Mehmet Bey bekâr.",
