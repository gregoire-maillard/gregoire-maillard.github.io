      "question": "How do you address Ayşe politely?",
      "options": ["Ayşe Hanım", "Hanım Ayşe"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Hanım* and *Bey* follow the first name, not the other way round."
      },
      "explain": "*Hanım* (Ms) and *Bey* (Mr) come after the first name: *Ayşe Hanım*, *Mehmet Bey*."
    },
    {
      "id": "a1-u03-l04-e02",
      "type": "listen",
      "mode": "type",
      "tr": "Memnun oldum, Mehmet Bey.",
      "en": "Nice to meet you, Mehmet."
    },
