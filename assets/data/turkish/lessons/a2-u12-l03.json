  "exercises": [
    {
      "id": "a2-u12-l03-e01",
      "type": "mcq",
      "points": ["gp-ca"],
      "question": "How do you say **in my opinion**?",
      "options": ["bence", "bana", "benimce", "bende"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Bana* is **to me**; **in my opinion** is *bana göre* or *bence*.",
        "2": "`-CA` goes straight on the pronoun: *bence*.",
        "3": "*Bende* is **on me**, **I have it**."
      },
      "explain": "*ben* + *-ce*: *bence*, the everyday way to give an opinion."
    },
    {
      "id": "a2-u12-l03-e02",
      "type": "cloze",
      "points": ["gp-ca"],
      "text": "Arkadaşım Rus___ biliyor.",
      "en": "My friend speaks Russian.",
      "blanks": [
        {
          "accept": ["ça"],
          "reject": [
            {
              "answer": "ca",
              "why": "After voiceless s, C becomes ç: *Rusça*."
            },
            {
              "answer": "çe",
              "why": "Two-way harmony after u: *-ça*."
            }
          ]
        }
      ],
      "explain": "*Rus* + *-ça*: s is voiceless, and u is a back vowel."
    },
