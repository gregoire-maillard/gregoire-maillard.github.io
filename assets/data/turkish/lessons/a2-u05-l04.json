{
  "id": "a2-u05-l04",
  "unit": "a2-u05",
  "order": 4,
  "title": "Nobody can know everything",
  "goal": "Use kimse, hiçbir şey and hiç with a negative verb, and ask whether someone has ever done something.",
  "points": ["gp-negative-polarity", "gp-abil", "gp-ama-inability", "gp-abil-uses"],
  "intro": {
    "text": "With *kimse* or *hiç kimse* (nobody), *hiçbir şey* (nothing) and *hiç* (never), the verb is always negative: *Kimse gelmedi* (Nobody came), *Hiçbir şey göremiyorum* (I can't see anything). In a question, *hiç* means **ever**: *Hiç Edirne'ye gittin mi?*",
    "see": "gp-negative-polarity"
  },
  "vocab": [
    {
      "tr": "hiç kimse",
      "en": "nobody, no one (with a negative verb)",
      "pos": "pron"
    },
    {
      "tr": "hiçbir şey",
      "en": "nothing (with a negative verb)",
      "pos": "pron",
      "card": "fc-0127"
    },
    {
      "tr": "biri",
      "en": "someone, somebody",
      "pos": "pron",
      "card": "fc-0043"
    },
    {
      "tr": "her şey",
      "en": "everything",
      "pos": "pron"
    },
    {
      "tr": "güreş",
      "en": "wrestling",
      "pos": "noun"
    },
    {
      "tr": "pehlivan",
      "en": "wrestler (in traditional wrestling)",
      "pos": "noun"
    }
  ],
  "exercises": [
    {
      "id": "a2-u05-l04-e01",
      "type": "mcq",
      "points": ["gp-negative-polarity"],
      "question": "How do you say **Nobody came**?",
      "options": ["Kimse gelmedi.", "Kimse geldi.", "Biri gelmedi."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Kimse* needs a negative verb: *gelmedi*.",
        "2": "*Biri gelmedi* is **someone didn't come**."
      },
      "explain": "*Kimse* or *hiç kimse* + a negative verb means **nobody**."
    },
    {
      "id": "a2-u05-l04-e02",
      "type": "cloze",
      "points": ["gp-negative-polarity", "gp-ama-inability"],
      "text": "Çok karanlık, hiçbir şey gör___.",
      "en": "It's very dark, I can't see anything.",
      "blanks": [
        {
          "accept": ["emiyorum"],
          "reject": [
            {
              "answer": "üyorum",
              "why": "*Hiçbir şey* needs a negative verb, and here **can't**: *göremiyorum*."
            },
            {
              "answer": "ebiliyorum",
              "why": "*Hiçbir şey* needs a negative verb: *göremiyorum*, **I can't see anything**."
            }
          ]
        }
      ],
      "explain": "*gör-* + *-e* + *-miyor* + *-um*: *göremiyorum*, with the negative that *hiçbir şey* needs."
    },
