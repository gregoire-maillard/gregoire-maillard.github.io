    {
      "id": "a1-u08-l01-e02",
      "type": "mcq",
      "points": ["gp-accusative"],
      "question": "Which sentence means **I'm drinking the coffee**?",
      "options": ["Kahveyi içiyorum.", "Kahve içiyorum.", "Kahveyi içiyoruz."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "Without an ending, *kahve* means **some coffee**: I'm having coffee.",
        "2": "*İçiyoruz* means **we are** drinking."
      },
      "explain": "A definite object takes `-(y)I`: *kahve* + *y* + *-i* = *kahveyi*."
    },
    {
      "id": "a1-u08-l01-e03",
      "type": "cloze",
      "points": ["gp-accusative", "gp-harmony-4way"],
      "text": "Bu film___ izliyor musun?",
      "en": "Are you watching this film?",
      "blanks": [
        {
          "accept": ["i"],
          "reject": [
            {
              "answer": "ı",
              "why": "The last vowel of *film* is i, a front vowel, so the ending is *-i*."
            },
            {
              "answer": "yi",
              "why": "*Film* ends in a consonant: no buffer y."
            }
          ]
        }
      ],
      "hint": "What does *bu* tell you about the object?",
      "explain": "After *bu*, the object is definite: *bu filmi*. Last vowel i, so *-i*."
    },
    {
