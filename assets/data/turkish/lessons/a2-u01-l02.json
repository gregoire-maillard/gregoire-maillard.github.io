      "id": "a2-u01-l02-e01",
      "type": "mcq",
      "points": ["gp-past-di-negative-question"],
      "question": "Someone speaks too fast. How do you say **Sorry, I didn't understand**?",
      "options": ["Pardon, anlamadım.", "Pardon, anladım.", "Pardon, anlamadın.", "Pardon, anlamadık."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Anladım* is positive: **I understood**.",
        "2": "*Anlamadın* is **you** didn't understand.",
        "3": "*Anlamadık* is **we** didn't understand."
      },
      "explain": "*anla-* + *-ma-* + *-dı* + *-m*. For something just said, Turks use the past: *Anlamadım*."
    },
