      "options": ["Yüzebilirim.", "Yüzabilirim.", "Yüzebilerim.", "Yüzüyorum."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The first vowel follows *yüz-*: ü is a front vowel, so *-ebil*.",
        "2": "After *bil* the aorist is always *-ir*: *-ebilirim*.",
        "3": "*Yüzüyorum* is **I am swimming**."
      },
      "explain": "*yüz-* + *-ebil* + *-ir* + *-im*: *yüzebilirim*."
    },
