    {
      "id": "a1-u04-l02-e02",
      "type": "mcq",
      "points": ["gp-question-mi"],
      "question": "How do you ask **Are you ready?**",
      "options": ["Hazır mısın?", "Hazır misin?", "Hazır musun?", "Hazırsın mı?"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "i follows e and i. The last vowel of *hazır* is ı, so the particle is *mı*.",
        "2": "u follows o and u. After ı, the particle is *mı*.",
        "3": "The ending for **you** goes on the particle, not on the adjective: *hazır mısın?*"
      },
      "explain": "*Hazır* ends in ı, so `mI` is *mı*, and *-sın* goes on it: *Hazır mısın?*"
    },
    {
      "id": "a1-u04-l02-e03",
