      "type": "translate",
      "from": "tr",
      "prompt": "İyiyim, teşekkürler. Sen nasılsın?",
      "accept": [
        "I am fine, thanks. How are you?",
        "I am fine, thanks. And you?",
        "I am fine, thank you. [How are you|And you|What about you]?",
        "I am [good|well|OK|okay], [thanks|thank you]. [How are you|And you|What about you]?",
        "[Fine|Good], [thanks|thank you]. [How are you|And you|What about you]?"
      ]
    },
    {
      "id": "a1-u01-l03-e11",
      "type": "translate",
      "from": "en",
