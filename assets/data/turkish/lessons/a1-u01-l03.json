  "exercises": [
    {
      "id": "a1-u01-l03-e01",
      "type": "match",
      "pairs": [
        ["ben", "I"],
        ["sen", "you"],
        ["memnun oldum", "nice to meet you"],
        ["iyiyim", "I am fine"],
        ["çok", "very"]
      ]
    },
    {
      "id": "a1-u01-l03-e02",
      "type": "mcq",
      "points": ["gp-sentence-basics"],
      "question": "How do you say **My name is Ayşe**?",
      "options": ["Benim adım Ayşe.", "Adın ne, Ayşe?", "Memnun oldum, Ayşe."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Adın ne?* asks for a name: what is your name?",
        "2": "*Memnun oldum* means nice to meet you."
      },
      "explain": "*Benim adım* means my name. Turkish needs no word for **is** in a short sentence like this."
    },
    {
      "id": "a1-u01-l03-e03",
      "type": "listen",
      "mode": "type",
      "tr": "Benim adım Can.",
      "en": "My name is Can."
    },
    {
      "id": "a1-u01-l03-e04",
      "type": "translate",
      "from": "en",
      "points": ["gp-sentence-basics"],
      "prompt": "My name is Zeynep.",
      "accept": ["Benim adım Zeynep.", "Adım Zeynep.", "Ben Zeynep."]
    },
    {
      "id": "a1-u01-l03-e05",
      "type": "translate",
      "from": "tr",
      "prompt": "Adın ne?",
      "accept": ["What is your name?"]
    },
    {
      "id": "a1-u01-l03-e06",
      "type": "mcq",
      "question": "You meet a friend's grandmother. How do you ask her name?",
      "options": ["Adınız ne?", "Adın ne?"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Adın ne?* is for a friend, a child or someone your own age in a relaxed setting."
      },
      "explain": "The longer *Adınız ne?* is polite: use it with older people and anyone you don't know well."
    },
    {
      "id": "a1-u01-l03-e07",
      "type": "wordbank",
      "from": "tr",
      "prompt": "Memnun oldum.",
      "text": "Nice to meet you.",
      "answer": ["Nice", "to", "meet", "you"],
      "distractors": ["good", "see", "name"]
    },
    {
      "id": "a1-u01-l03-e08",
      "type": "mcq",
      "points": ["gp-stress-basics"],
      "question": "Where is the stress in the name *Ayşe*?",
      "options": ["On the last syllable: ay-ŞE", "On the first syllable: AY-şe"],
      "optionsLang": "en",
      "answer": 0,
      "explain": "Most Turkish words, first names included, are stressed on the last syllable: *ay-ŞE*, *meh-MET*, *ki-TAP*."
    },
    {
      "id": "a1-u01-l03-e09",
