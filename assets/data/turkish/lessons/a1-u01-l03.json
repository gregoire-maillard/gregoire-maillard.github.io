{
  "id": "a1-u01-l03",
  "unit": "a1-u01",
  "order": 3,
  "title": "What's your name?",
  "goal": "Introduce yourself, ask someone's name and say you are pleased to meet them.",
  "points": ["gp-sentence-basics", "gp-stress-basics"],
  "intro": {
    "text": "To give your name, say *Benim adım…* (my name is…) or simply *Ben…*: *Ben Elif.* There is no verb in these short sentences. To ask, say *Adın ne?* to a friend and *Adınız ne?* to someone you address politely.",
    "see": "gp-sentence-basics"
  },
  "vocab": [
    {
      "tr": "ben",
      "en": "I",
      "pos": "pron",
      "card": "fc-0005"
    },
    {
      "tr": "sen",
      "en": "you (one person, familiar)",
      "pos": "pron",
      "card": "fc-0006"
    },
    {
      "tr": "benim adım",
      "en": "my name is",
      "pos": "phrase"
    },
    {
      "tr": "Adın ne?",
      "en": "What is your name?",
      "pos": "phrase"
    },
    {
      "tr": "Adınız ne?",
      "en": "What is your name? (polite)",
      "pos": "phrase"
    },
    {
      "tr": "memnun oldum",
      "en": "nice to meet you",
      "pos": "phrase"
    },
    {
      "tr": "ben de",
      "en": "me too",
      "pos": "phrase"
    },
    {
      "tr": "Nasılsın?",
      "en": "How are you?",
      "pos": "phrase"
    },
    {
      "tr": "Nasılsınız?",
      "en": "How are you? (polite or plural)",
      "pos": "phrase"
    },
    {
      "tr": "iyiyim",
      "en": "I am fine",
      "pos": "phrase"
    },
    {
      "tr": "çok",
      "en": "very, a lot",
