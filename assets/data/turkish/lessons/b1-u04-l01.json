    {
      "id": "b1-u04-l01-e02",
      "type": "mcq",
      "points": ["gp-mak-cases"],
      "question": "How do you say **I love reading**?",
      "options": ["Okumayı seviyorum.", "Okumaya seviyorum.", "Okumaktan seviyorum.", "Okumak seviyorum."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The dative goes with verbs like *başlamak*: *okumaya başladım*.",
        "2": "The ablative goes with verbs like *korkmak* and *hoşlanmak*: *okumaktan hoşlanıyorum*.",
        "3": "Only *istemek* takes the bare infinitive: *okumak istiyorum*."
      },
      "explain": "*Sevmek* takes the accusative, as in *kitabı seviyorum*: *oku-ma-y-ı seviyorum*."
    },
    {
      "id": "b1-u04-l01-e03",
      "type": "cloze",
      "points": ["gp-mak-cases"],
      "text": "Geçen yıl Türkçe öğren___ başladım.",
      "en": "Last year I started learning Turkish.",
      "blanks": [
        {
          "accept": ["meye"],
          "reject": [
            {
              "answer": "meyi",
              "why": "*Başlamak* takes the dative, as in *okula başlamak*: *öğrenmeye*."
            },
            {
              "answer": "mek",
              "why": "*Başlamak* needs the dative: *öğrenmeye başladım*."
            },
            {
              "answer": "maya",
              "why": "Harmony: the last vowel of *öğren-* is e, so *-meye*."
            }
          ]
        }
      ],
      "explain": "*öğren-* + *-me* + y + *-e* (dative): the k of *-mek* drops before the vowel."
    },
    {
      "id": "b1-u04-l01-e04",
      "type": "cloze",
      "points": ["gp-mak-cases"],
      "text": "Çocuk karanlıkta uyumak___ korkuyor.",
      "en": "The child is afraid of sleeping in the dark.",
      "blanks": [
        {
          "accept": ["tan"],
          "reject": [
            {
              "answer": "dan",
              "why": "After the voiceless k, the ablative is *-tan*: *uyumaktan*."
            },
            {
              "answer": "ta",
              "why": "*Korkmak* takes the ablative *-DAn*: *uyumaktan korkuyor*."
            }
          ]
        }
      ],
      "explain": "*Korkmak* takes the ablative. Before a consonant the k stays: *uyumak-tan*."
    },
