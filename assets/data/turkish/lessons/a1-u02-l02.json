      "points": ["gp-vowel-groups"],
      "question": "Which of these is a **back** vowel?",
      "options": ["ı", "i", "ü", "e"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The dotted *i* is a front vowel.",
        "2": "*ü* is a front vowel, said with rounded lips.",
        "3": "*e* is a front vowel."
      },
      "explain": "Back vowels: *a, ı, o, u*. Front vowels: *e, i, ö, ü*. The dotless *ı* is back, the dotted *i* front."
    },
