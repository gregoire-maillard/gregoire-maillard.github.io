      "options": ["Sigara içmem.", "Sigara içmezim.", "Sigara içmez.", "Sigara içmiyor."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "For **I** the z drops: *-mAm*, so *içmem*.",
        "2": "*İçmez* is **he** or **she** doesn't smoke.",
        "3": "*İçmiyor* is the present continuous, for **he** or **she**."
      },
      "explain": "Negative aorist for **I**: *-mAm*, so *içmem*."
    },
