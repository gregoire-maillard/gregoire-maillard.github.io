    {
      "id": "b1-u10-l03-e04",
      "type": "mcq",
      "points": ["gp-reflexive", "gp-passive"],
      "question": "*Çocuk yıkandı.* What can it mean?",
      "options": ["The child had a wash, or was washed.", "The child washed the dishes.", "The child is washing."],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "Washing something else takes the plain verb with an object: *bulaşıkları yıkadı*.",
        "2": "*Yıkandı* is in the past."
      },
      "explain": "After a vowel, the reflexive and the passive are both *-n*: *yıkandı* is **had a wash** or **was washed**, and context decides."
    },
    {
      "id": "b1-u10-l03-e05",
      "type": "cloze",
      "points": ["gp-kendi"],
      "text": "Aynada kendi___ baktım.",
      "en": "I looked at myself in the mirror.",
      "blanks": [
        {
          "accept": ["me"],
          "reject": [
            {
              "answer": "mi",
              "why": "*Bakmak* takes the dative, not the accusative: *kendime*."
            },
            {
              "answer": "m",
              "why": "*Bakmak* needs the dative: *kendi-m-e*, **at myself**."
            },
            {
              "answer": "ne",
              "why": "*Kendine* is **at yourself** or **at himself**. **At myself**: *kendime*."
            }
          ]
        }
      ],
      "explain": "*kendi* + *-m* (my) + *-e*: *bakmak* takes the dative, so **at myself** is *kendime*."
    },
