  "exercises": [
    {
      "id": "a1-u07-l04-e01",
      "type": "mcq",
      "points": ["gp-dative"],
      "question": "How do you say **to the right**?",
      "options": ["sağa", "sağda", "sağdan"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Sağda* means **on the right**: where something is.",
        "2": "*Sağdan* means **from the right**."
      },
      "explain": "A direction takes the dative: *sağ* + *-a* = *sağa*."
    },
    {
      "id": "a1-u07-l04-e02",
      "type": "translate",
      "from": "tr",
      "points": ["gp-dative", "gp-question-mi"],
      "prompt": "Otel buraya yakın mı?",
      "accept": ["Is the hotel near here?", "Is the hotel close to here?", "Is the hotel nearby?", "Is the hotel close by?"]
    },
    {
      "id": "a1-u07-l04-e03",
      "type": "cloze",
      "points": ["gp-ablative", "gp-pronoun-cases-dat-abl"],
      "text": "Müze bura___ uzak mı?",
      "en": "Is the museum far from here?",
      "blanks": [
        {
          "accept": ["dan"],
          "reject": [
            {
              "answer": "ya",
              "why": "*Uzak* takes the ablative: far **from** here, *buradan*. *Buraya* goes with *yakın*."
            },
            {
              "answer": "da",
              "why": "*Burada* means **here**. Far **from** here is *buradan uzak*."
            }
          ]
        }
      ],
      "explain": "*Uzak* (far) takes the ablative, *buradan uzak*; *yakın* (near) takes the dative, *buraya yakın*."
    },
