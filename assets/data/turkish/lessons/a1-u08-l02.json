      "points": ["gp-consonant-softening", "gp-accusative"],
      "question": "What is the accusative of *kitap*?",
      "options": ["kitabı", "kitapı", "kitabu", "kitapi"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "Before a vowel, the p of *kitap* softens to b.",
        "2": "The last vowel of *kitap* is a, so the ending is *-ı*.",
        "3": "Both the consonant and the vowel are off: *kitabı*."
      },
      "explain": "p becomes b before a vowel, then *-ı* after a: *kitabı*."
    },
    {
