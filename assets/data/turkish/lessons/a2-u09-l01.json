    },
    {
      "id": "a2-u09-l01-e02",
      "type": "mcq",
      "points": ["gp-place-nouns"],
      "question": "How do you say **under the bed**?",
      "options": ["yatağın altında", "yatağın altta", "yatağın altıda", "yatakta altında"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "After *yatağın*, *alt* needs the possessive: *altında*. *Altta* alone means **downstairs**, **at the bottom**.",
        "2": "After the possessive comes an n before the case ending: *altında*.",
        "3": "The bed goes into the genitive: *yatağın*."
      },
      "explain": "*yatağın* (of the bed) + *alt* + *-ı* + n + *-da*: **under the bed**."
    },
    {
      "id": "a2-u09-l01-e03",
      "type": "cloze",
      "points": ["gp-place-nouns", "gp-pronominal-n"],
      "text": "Anahtarlar masanın üst___.",
      "en": "The keys are on the table.",
      "blanks": [
        {
          "accept": ["ünde"],
          "reject": [
            {
              "answer": "ünda",
              "why": "The vowel of *üst* is ü, a front vowel: *üstünde*."
            },
            {
              "answer": "üde",
              "why": "After a possessive, case endings need an n: *üstünde*."
            }
          ]
        }
      ],
      "explain": "*üst* + *-ü* (its) + n + *-de*: *masanın üstünde*."
    },
    {
      "id": "a2-u09-l01-e04",
      "type": "translate",
      "points": ["gp-place-nouns"],
      "from": "en",
      "prompt": "The cat is under the table.",
      "accept": ["Kedi masanın altında.", "Kedi masanın altındadır."],
      "reject": [
        {
          "answer": "Kedi masanın üstünde.",
          "why": "*Üstünde* means **on**. **Under** is *altında*."
        }
      ]
    },
    {
      "id": "a2-u09-l01-e05",
      "type": "translate",
      "points": ["gp-place-nouns"],
      "from": "tr",
