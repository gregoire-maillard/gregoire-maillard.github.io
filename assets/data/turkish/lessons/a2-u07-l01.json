      "type": "mcq",
      "points": ["gp-optative"],
      "question": "How do you say **Let's go to the cinema**?",
      "options": ["Sinemaya gidelim.", "Sinemaya gitelim.", "Sinemaya gideriz.", "Sinemaya gidiyoruz."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*git-* softens to *gid-* before a vowel, as in *gidiyor* and *gidecek*.",
        "2": "*Gideriz* is the aorist, **we go** or **we'll go**: a habit or a promise, not a suggestion.",
        "3": "*Gidiyoruz* means **we are going**."
      },
      "explain": "*gid-* + *-elim*: *gidelim*, **let's go**."
    },
