      "points": ["gp-present-continuous-negative"],
      "question": "How do you say **I don't know**?",
      "options": ["Bilmiyorum.", "Biliyorum.", "Bilmeyorum.", "Bilmıyorum."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Biliyorum* means **I know**.",
        "2": "The negative before *-yor* has a high vowel: *-mi-*, not *-me-*.",
        "3": "After the i of *bil-*, the negative is *-mi-*, with i."
      },
      "explain": "Negative: stem + `-mI-` + *-yor*: *bil-* + *-mi-* + *-yor* + *-um*."
    },
