      "id": "a1-u01-l01-e01",
      "type": "mcq",
      "question": "What do you say to someone in the **morning**?",
      "options": ["Günaydın.", "İyi geceler.", "İyi akşamlar.", "Güle güle."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*İyi geceler* is good night: said late in the evening or before going to bed.",
        "2": "*İyi akşamlar* is good evening.",
        "3": "*Güle güle* is goodbye, said by the person who stays."
      },
      "explain": "*Günaydın* is good morning: *gün* (day) + *aydın* (bright)."
    },
