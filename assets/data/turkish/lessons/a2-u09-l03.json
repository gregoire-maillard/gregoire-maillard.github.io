      "points": ["gp-postp-ablative", "gp-consonant-assimilation"],
      "question": "How do you say **after the lesson**?",
      "options": ["dersten sonra", "derse sonra", "dersin sonra", "dersden sonra"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Sonra* takes the ablative, not the dative.",
        "2": "*Sonra* takes the ablative, not the genitive.",
        "3": "*s* is voiceless, so the ablative is *-ten*: *dersten*."
      },
      "explain": "*ders* + *-ten* + *sonra*: **after the lesson**."
    },
