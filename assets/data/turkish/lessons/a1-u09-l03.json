      "points": ["gp-vowel-loss"],
      "question": "How do you say **my son**?",
      "options": ["oğlum", "oğulum", "oğlüm", "oğulm"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "*Oğul* loses its second vowel before a vowel suffix: *oğlum*.",
        "2": "The vowel left in the word is o, so the suffix has u: *-um*.",
        "3": "After a consonant the suffix needs its vowel: *-um*."
      },
      "explain": "*Oğul* + *-um*: the u of the last syllable drops, *oğlum*."
    },
