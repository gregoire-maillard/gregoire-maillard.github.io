      "type": "mcq",
      "points": ["gp-ci"],
      "question": "How do you say **bookshop**?",
      "options": ["kitapçı", "kitapcı", "kitabçı", "kitaplık"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "After voiceless p, C becomes ç: *kitapçı*.",
        "2": "The stem doesn't soften before a suffix that starts with a consonant: *kitap*.",
        "3": "*Kitaplık* is a bookcase."
      },
      "explain": "*kitap* + *-çı*: the bookseller and the bookshop."
    },
    {
      "id": "a2-u12-l02-e02",
