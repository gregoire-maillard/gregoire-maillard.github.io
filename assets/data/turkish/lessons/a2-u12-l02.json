      "en": "journalist",
      "pos": "noun"
    },
    {
      "tr": "kitapçı",
      "en": "bookseller; bookshop",
      "pos": "noun"
    },
    {
      "tr": "çiçekçi",
      "en": "florist; flower shop",
      "pos": "noun"
    },
    {
      "tr": "balıkçı",
      "en": "fisherman; fishmonger, fish restaurant",
      "pos": "noun"
    },
    {
      "tr": "yolcu",
      "en": "passenger, traveller",
      "pos": "noun"
    },
    {
      "tr": "kitaplık",
      "en": "bookcase, bookshelf",
      "pos": "noun"
    },
    {
      "tr": "kişi",
      "en": "person; people (after a number)",
      "pos": "noun",
      "card": "fc-0186"
    }
  ],
