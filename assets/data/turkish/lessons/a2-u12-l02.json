      "blanks": [
        {
          "accept": ["ci"],
          "reject": [
            {
              "answer": "çi",
              "why": "After a vowel, C stays c: *gazeteci*."
            },
            {
              "answer": "cı",
              "why": "Four-way harmony after e: *gazeteci*."
            }
          ]
        }
      ],
      "explain": "*gazete* + *-ci*: **journalist**, someone who works for newspapers."
    },
