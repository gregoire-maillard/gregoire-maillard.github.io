      "text": "Saat ___ çeyrek var.",
      "en": "It's a quarter to four.",
      "blanks": [
        {
          "accept": ["dörde"],
          "reject": [
            {
              "answer": "dörte",
              "why": "Before a vowel the t of *dört* softens: *dörde*."
