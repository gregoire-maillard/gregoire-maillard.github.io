      "prompt": "It's ten past three.",
      "accept": ["Saat üçü on geçiyor.", "Üçü on geçiyor."],
      "reject": [
        {
          "answer": "Saat üçe on geçiyor.",
          "why": "Minutes **past** take the accusative: *üçü*. The dative goes with *var*: *üçe on var*."
        }
      ]
    },
    {
      "id": "a1-u11-l03-e04",
      "type": "cloze",
