    {
      "id": "a1-u09-l02-e01",
      "type": "mcq",
      "points": ["gp-possessive-have"],
      "question": "How do you say **I have a cat**?",
      "options": ["Bir kedim var.", "Ben bir kedi var.", "Bir kedi var.", "Bir kedin var."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "Turkish has no verb **to have**: the owner goes into the suffix, *kedim*.",
        "2": "*Bir kedi var* means **there is a cat**.",
        "3": "*Kedin* is **your** cat."
      },
      "explain": "Owned noun + *var*: *Bir kedim var*, literally a cat of mine exists."
    },
    {
      "id": "a1-u09-l02-e02",
      "type": "translate",
      "from": "en",
      "points": ["gp-possessive-have"],
      "prompt": "I do not have time.",
      "accept": ["Zamanım yok.", "Benim zamanım yok."],
      "reject": [
        {
          "answer": "Zaman yok.",
          "why": "*Zaman yok* means **there's no time**. For **I** don't have, add *-ım*: *zamanım yok*."
        },
        {
          "answer": "Zamanım değil.",
          "why": "Possession takes *yok*, not *değil*: *zamanım yok*."
        }
      ]
    },
