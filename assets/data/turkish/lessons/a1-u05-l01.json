    {
      "id": "a1-u05-l01-e02",
      "type": "mcq",
      "points": ["gp-locative", "gp-consonant-assimilation"],
      "question": "How do you say **at school**?",
      "options": ["okulda", "okulde", "okulta"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The last vowel of *okul* is u, a back vowel, so the suffix takes a.",
        "2": "The t form only comes after a voiceless consonant, and l is voiced."
      },
      "explain": "Back vowel u, voiced l: *okul* + *-da* = *okulda*."
    },
    {
      "id": "a1-u05-l01-e03",
      "type": "cloze",
      "points": ["gp-locative", "gp-consonant-assimilation"],
      "text": "Ali park___, Ayşe ev___.",
      "en": "Ali is in the park, Ayşe is at home.",
      "blanks": [
        {
          "accept": ["ta"],
          "reject": [
            {
              "answer": "da",
              "why": "*k* is voiceless, so the d turns into t: *parkta*."
            },
            {
              "answer": "te",
              "why": "The last vowel of *park* is a, a back vowel: *-ta*, not *-te*."
            }
          ]
        },
        {
          "options": ["de", "da", "te"],
          "answer": 0
        }
      ],
      "hint": "Is the last sound of *park* voiced or voiceless?",
      "explain": "*Park* ends in voiceless k → *-ta*; *ev* has a front vowel and ends in voiced v → *-de*."
    },
    {
      "id": "a1-u05-l01-e04",
      "type": "translate",
      "from": "en",
      "points": ["gp-locative", "gp-copula-present"],
      "prompt": "I am at home.",
      "accept": ["Evdeyim.", "Ben evdeyim."],
      "reject": [
        {
          "answer": "Evdesin.",
          "why": "*Evdesin* means **you are** at home. **I am** takes *-yim*."
        },
        {
          "answer": "Evdeim.",
          "why": "*Evde* ends in a vowel, so a buffer y comes before the ending: *evdeyim*."
        }
      ],
      "explain": "*ev* + *-de* (at home) + *-yim* (I am)."
    },
    {
      "id": "a1-u05-l01-e05",
