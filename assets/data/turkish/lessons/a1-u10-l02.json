      "type": "mcq",
      "points": ["gp-genitive-possessive"],
      "question": "Which is the most natural way to say **My jacket is here**, with no special emphasis?",
      "options": ["Ceketim burada.", "Benim ceketim burada.", "Ben ceketim burada."],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "Correct, but *benim* adds emphasis: **my** jacket, not yours.",
        "2": "*Ben* can't mean **my**: that needs the genitive, *benim*."
      },
      "explain": "The suffix *-im* already says **my**, so Turkish leaves the pronoun out unless it is stressed."
    },
