    {
      "id": "a1-u10-l02-e03",
      "type": "mcq",
      "points": ["gp-genitive", "gp-genitive-possessive"],
      "question": "How do you say **our neighbourhood**, with the pronoun?",
      "options": ["bizim mahallemiz", "bizin mahallemiz", "bizim mahallesi", "biz mahallemiz"],
      "optionsLang": "tr",
      "answer": 0,
      "why": {
        "1": "The genitive of *biz* is irregular: *bizim*.",
        "2": "With *bizim*, the neighbourhood takes **our** as well: *mahallemiz*.",
        "3": "The pronoun needs the genitive: *bizim*."
      },
      "explain": "*Bizim* + *mahalle* + *-miz*: both words say **our**."
    },
    {
      "id": "a1-u10-l02-e04",
      "type": "translate",
      "points": ["gp-genitive-possessive", "gp-question-mi"],
      "from": "en",
      "prompt": "Is this your wallet?",
      "accept": ["Bu senin cüzdanın mı?", "Bu cüzdanın mı?", "Bu (sizin) cüzdanınız mı?", "Bu cüzdan [senin|sizin] mi?"],
      "reject": [
        {
