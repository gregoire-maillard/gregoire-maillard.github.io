    { "tk": "ýaryş", "en": "race, competition", "pos": "noun" },
    { "tk": "ýeňmek", "en": "to beat, to defeat", "pos": "verb", "card": "fc-0979" },
    { "tk": "gaty", "en": "loudly; very", "pos": "adv", "card": "fc-0250" }
  ],
  "exercises": [
    {
