      "accept": ["Ol oturgyç.", "Ol bir oturgyç."]
    },
    {
      "id": "a1-u02-l01-e12",
      "type": "mcq",
      "points": ["gp-bir-indefinite"],
      "question": "Turkmen has no word for **the**. What can *bir* mean?",
      "options": ["one, or a", "the", "this"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "No Turkmen word means **the**: *kitap* is a book or the book.",
        "2": "**this** is *bu*."
      },
      "explain": "*bir* is the number one, and it can also work as **a**: *bir kitap*, a book or one book."
    }
  ]
