      ]
    },
    {
      "id": "a1-u02-l01-e02",
      "type": "mcq",
      "points": ["gp-demonstratives"],
      "question": "What does *Bu näme?* mean?",
      "options": ["What is this?", "Who is this?", "Is this a book?"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "**Who** is *kim*: *Bu kim?*",
        "2": "There is no word for **book** here; *näme* means **what**."
      },
      "explain": "*bu* is this and *näme* is what. No word for **is** is needed: *Bu näme?* is literally “this what?”."
    },
    {
      "id": "a1-u02-l01-e03",
      "type": "translate",
      "points": ["gp-demonstratives", "gp-bir-indefinite"],
      "from": "en",
      "prompt": "This is a book.",
      "accept": ["Bu kitap.", "Bu bir kitap."]
    },
    {
      "id": "a1-u02-l01-e04",
      "type": "translate",
      "points": ["gp-demonstratives"],
      "from": "tk",
      "prompt": "Ol sumka.",
      "accept": ["That is a bag.", "That is the bag.", "It is a bag."]
    },
    {
      "id": "a1-u02-l01-e05",
      "type": "mcq",
      "points": ["gp-demonstratives"],
      "question": "Which word asks about a **person**?",
      "options": ["kim", "näme"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*näme* is **what**: for things."
      },
      "explain": "*Bu kim?* Who is this? *Bu näme?* What is this?"
    },
    {
      "id": "a1-u02-l01-e06",
      "type": "cloze",
      "points": ["gp-bir-indefinite"],
      "text": "Bu ___ kitap.",
      "en": "This is a book.",
      "blanks": [
        {
          "accept": ["bir"]
        }
      ],
      "explain": "*bir* can work like **a**: *Bu bir kitap*. Without it, *Bu kitap* means the same."
    },
    {
      "id": "a1-u02-l01-e07",
      "type": "wordbank",
      "points": ["gp-demonstratives"],
      "from": "en",
      "prompt": "What is that?",
      "text": "Ol näme?",
      "answer": ["Ol", "näme"],
      "distractors": ["bu", "kim", "bir"]
    },
    {
      "id": "a1-u02-l01-e08",
      "type": "translate",
      "from": "tk",
      "prompt": "Bu kim? Bu Merjen.",
      "accept": ["Who is this? This is Merjen.", "Who is this? [It is|She is] Merjen."]
    },
    {
      "id": "a1-u02-l01-e09",
      "type": "mcq",
      "points": ["gp-demonstratives"],
      "question": "Which word means **this right here**, for something you are pointing at?",
      "options": ["şu", "ol", "şol"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*ol* is **that**, farther away.",
        "2": "*şol* is **that one**: something you both already know about."
      },
      "explain": "*şu* points at what is right here, or at what was just mentioned. In most sentences *bu* works too."
    },
    {
      "id": "a1-u02-l01-e10",
      "type": "translate",
      "from": "en",
      "prompt": "Who is this?",
      "accept": ["Bu kim?"]
    },
    {
      "id": "a1-u02-l01-e11",
