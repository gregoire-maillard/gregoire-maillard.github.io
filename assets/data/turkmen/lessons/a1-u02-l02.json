  "title": "Front and back vowels",
  "goal": "Tell front vowels from back vowels and make plurals with -lar and -ler.",
  "points": ["gp-vowel-groups", "gp-harmony-2way", "gp-plural"],
  "intro": {
    "text": "The plural ending follows the last vowel of the word. After a back vowel (*a, o, u, y*) it is *-lar*: *kitaplar*, books. After a front vowel (*e, ä, i, ö, ü*) it is *-ler*: *öýler*, houses. Borrowed words follow their last vowel too: *telefonlar*.",
    "see": "gp-harmony-2way"
  },
