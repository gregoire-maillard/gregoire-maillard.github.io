        { "p": "siz", "accept": ["okamalydyňyz"] },
        { "p": "olar", "accept": ["okamalydylar", "okamalydy"] }
      ],
      "explain": "*okamaly* + *-dy* + the past endings: *okamalydym, okamalydyň…*"
    },
