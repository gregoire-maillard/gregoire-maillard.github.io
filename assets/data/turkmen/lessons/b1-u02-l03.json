  "title": "You should have come early",
  "goal": "Say what someone should have done, or was supposed to do, with -mAlYdY.",
  "points": ["gp-should-have", "gp-maly-bolmak", "gp-compound-tenses"],
  "intro": {
    "text": "Add `-dY` and the past endings to `-mAlY`: *Sen ir gelmelidiň*, you should have come early. **Shouldn't have**: *gelmeli däldiň*. Compare *gitmeli boldum*, I had to go (and did), with *gitmelidim*, I should have gone, or was supposed to.",
    "see": "gp-should-have"
  },
  "vocab": [
    { "tk": "ötünç soramak", "en": "to apologize", "pos": "verb", "card": "fc-0211" },
    { "tk": "öňünden", "en": "in advance, beforehand", "pos": "adv" },
    { "tk": "maslahat", "en": "advice", "pos": "noun", "card": "fc-0963" },
    { "tk": "maslahat bermek", "en": "to advise, to give advice", "pos": "verb", "card": "fc-0963" }
  ],
  "exercises": [
    {
      "id": "b1-u02-l03-e01",
      "type": "mcq",
      "points": ["gp-should-have"],
      "question": "Which is **you should have come early**?",
      "options": ["Sen ir gelmelidiň.", "Sen ir gelmeli.", "Sen ir gelmeli bolduň.", "Sen ir geldiň."],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*gelmeli* is now or later: **you must come early**.",
        "2": "*gelmeli bolduň* says **you had to come early**, and you did.",
        "3": "*geldiň* is **you came early**."
      },
      "explain": "*gel-* + *-meli* + *-di* + *-ň*: *gelmelidiň*, you should have come."
    },
    {
      "id": "b1-u02-l03-e02",
      "type": "conjugate",
      "points": ["gp-should-have", "gp-compound-tenses"],
      "base": "okamak",
