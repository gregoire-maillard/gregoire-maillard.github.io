    { "tk": "eşitmek", "en": "to hear", "pos": "verb", "card": "fc-0104" },
    { "tk": "habar", "en": "news; message", "pos": "noun", "card": "fc-0204" },
    { "tk": "gutarmak", "en": "to finish; to end", "pos": "verb", "card": "fc-0192" },
    { "tk": "ýöremek", "en": "to walk", "pos": "verb", "card": "fc-0317" }
  ],
  "exercises": [
    {
      "id": "a2-u01-l03-e01",
      "type": "mcq",
      "points": ["gp-person-endings-types"],
      "question": "Which one is **I worked**?",
      "options": ["işledim", "işleýärin", "işledik", "işledin"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*işleýärin* is the present: **I work**, **I'm working**.",
        "2": "*işledik* is **we worked**: *-k* is **we** in the past.",
        "3": "*-in* is the present's ending for **I**. The past takes *-m*: *işledim*."
      },
      "explain": "Past *-di* + the second set's **I**, *-m*: *işledim*."
    },
    {
      "id": "a2-u01-l03-e02",
      "type": "cloze",
      "points": ["gp-person-endings-types", "gp-present-yar", "gp-past-dy"],
      "text": "Men şu gün işleýär___, düýn hem işledi___.",
      "en": "I'm working today, and I worked yesterday too.",
      "blanks": [
        {
          "accept": ["in"],
          "reject": [{ "answer": "im", "why": "*-m* is the past's ending. After *-ýär*, **I** is *-in*: *işleýärin*." }]
        },
        {
          "accept": ["m"],
          "reject": [{ "answer": "n", "why": "After the past *-di*, **I** is *-m*: *işledim*." }]
        }
      ],
      "explain": "Present: *işleýär* + *-in*. Past: *işledi* + *-m*."
    },
    {
      "id": "a2-u01-l03-e03",
      "type": "translate",
      "points": ["gp-person-endings-types", "gp-past-dy"],
      "from": "en",
