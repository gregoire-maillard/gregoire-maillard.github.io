    {
      "id": "a2-u01-l03-e06",
      "type": "mcq",
      "points": ["gp-person-endings-types"],
      "question": "*Biz geldik* and *Biz gelýäris*: what is the difference?",
      "options": ["*geldik* is the past, *gelýäris* the present", "*geldik* is a question", "None: they mean the same"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "A question would have *-mi*: *geldikmi?*",
        "2": "*-di* + *-k* is the past (**we came**); *-ýär* + *-is* is the present (**we're coming**)."
      },
      "explain": "**We** is *-k* in the past and *-is* in the present: *geldik*, *gelýäris*."
    },
