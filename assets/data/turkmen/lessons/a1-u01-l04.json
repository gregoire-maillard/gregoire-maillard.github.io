      "id": "a1-u01-l04-e01",
      "type": "mcq",
      "context": [
        {
          "who": "Aýna",
          "tk": "Salam, Merdan!",
          "en": "Hi, Merdan!"
        },
        {
          "who": "Merdan",
          "tk": "Salam, Aýna! Ýagdaýlaryň nähili?",
          "en": "Hi, Aýna! How are you?"
        },
        {
          "who": "Aýna",
          "tk": "Gowy, sag bol. Özüň nähili?"
        }
      ],
      "question": "What does Aýna ask Merdan at the end?",
      "options": ["How about you?", "What is your name?", "Is that OK?"],
      "optionsLang": "en",
      "answer": 0,
      "explain": "*Özüň nähili?* turns the question back: and how are you?"
    },
    {
      "id": "a1-u01-l04-e02",
      "type": "mcq",
      "points": ["gp-alphabet"],
      "question": "Which letter comes right after *e* in the Turkmen alphabet?",
      "options": ["ä", "f", "i"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*f* comes after *ä*: a b ç d e ä f…",
        "2": "*i* comes later: … g h i j ž k…"
      },
      "explain": "Most marked letters follow their plain one: e, ä; n, ň; o, ö; s, ş; u, ü; y, ý."
    },
    {
      "id": "a1-u01-l04-e03",
      "type": "translate",
      "from": "en",
      "prompt": "Welcome!",
      "accept": ["Hoş geldiňiz!", "Hoş geldiň!"],
      "explain": "*Hoş geldiňiz!* to anyone you speak to politely or to several people; *Hoş geldiň!* to a friend."
    },
    {
      "id": "a1-u01-l04-e04",
      "type": "translate",
      "from": "tk",
      "prompt": "Erbet däl, sag boluň.",
      "accept": ["Not bad, thank you.", "Not bad, thanks."]
