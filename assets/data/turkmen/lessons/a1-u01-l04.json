  "order": 4,
  "title": "Meeting people",
  "goal": "Hold a first conversation: greet, ask how someone is, give your name and say goodbye.",
  "points": ["gp-sentence-basics", "gp-alphabet", "gp-pronunciation", "gp-vowel-length"],
  "intro": {
    "text": "Put it all together: greet, ask how someone is, give your name and say goodbye. With someone older, or someone you don't know, use the polite forms: *Ýagdaýlaryňyz nähili?*, *Adyňyz näme?*, *Sag boluň*. *Hoş geldiňiz!* means **welcome!**",
    "see": "gp-sentence-basics"
  },
  "vocab": [
    {
      "tk": "hoş geldiňiz",
      "en": "welcome",
      "pos": "phrase"
    },
    {
      "tk": "Ýagdaýlaryňyz nähili?",
      "en": "How are you? (polite)",
      "pos": "phrase"
    },
