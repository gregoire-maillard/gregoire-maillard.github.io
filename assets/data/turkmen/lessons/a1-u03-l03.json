      "points": ["gp-nationality-words", "gp-copula-present"],
      "from": "en",
      "prompt": "I am Turkmen.",
      "accept": ["Men türkmen.", "(Men) türkmendirin."]
    },
    {
      "id": "a1-u03-l03-e03",
      "type": "mcq",
      "points": ["gp-nationality-words"],
      "question": "In a Turkmen sentence, does the word for a Turkmen person start with a capital letter?",
      "options": ["No: türkmen", "Yes: Türkmen"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "Nationality words take no capital; only names of countries and towns do: *Türkmenistan*."
      },
      "explain": "*Men türkmen*, lowercase, like *iňlis*, *rus* and *nemes*."
    },
    {
      "id": "a1-u03-l03-e04",
      "type": "translate",
      "points": ["gp-nationality-words"],
      "from": "tk",
      "prompt": "Siz nireli?",
      "accept": ["Where are you from?"]
    },
    {
      "id": "a1-u03-l03-e05",
      "type": "cloze",
      "points": ["gp-nationality-words", "gp-harmony-rounding"],
      "text": "Men Aşgabat___.",
      "en": "I'm from Ashgabat.",
      "blanks": [
        {
          "accept": ["ly"],
          "reject": [
            {
              "answer": "li",
              "why": "The last vowel of *Aşgabat* is *a*, a back vowel: *Aşgabatly*."
            }
          ]
        }
      ],
      "explain": "`-lY` after the back vowel *a*: *Aşgabatly*. The ending is written straight onto the name, with no apostrophe or hyphen."
    },
    {
      "id": "a1-u03-l03-e06",
      "type": "morph",
      "points": ["gp-nationality-words", "gp-harmony-rounding"],
      "base": "Tejen",
      "gloss": "from Tejen",
      "parts": ["Tejen", "li"],
      "distractors": ["ly", "le", "lü"],
      "result": "Tejenli",
      "explain": "The last vowel of *Tejen* is *e*, a front vowel: *-li*. No rounding, since *e* is unrounded."
    },
    {
      "id": "a1-u03-l03-e07",
      "type": "mcq",
      "points": ["gp-nationality-words"],
      "question": "What does *Ol iňlis* mean?",
      "options": ["She is English.", "She speaks English.", "She is in England."],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "Speaking a language needs a verb; verbs start in [A1 unit 6](a1-u06).",
        "2": "**In England** needs a place ending, which comes in [A1 unit 5](a1-u05)."
      },
      "explain": "*iňlis* is an English person; with the short form of **to be**, *Ol iňlis* is she or he is English."
    },
    {
      "id": "a1-u03-l03-e08",
      "type": "translate",
      "points": ["gp-nationality-words"],
      "from": "en",
      "prompt": "We are from Mary.",
      "accept": ["Biz Maryly."],
      "explain": "*Mary* ends in the back vowel *y*: *Maryly*."
    },
    {
      "id": "a1-u03-l03-e09",
      "type": "wordbank",
      "points": ["gp-nationality-words"],
      "from": "en",
      "prompt": "Where are you from? – I'm from Dashoguz.",
