      "answer": ["Siz", "nireli", "Men", "Daşoguzly"],
      "distractors": ["Daşoguz", "näme", "sen"],
      "accept": ["Sen nireli? Men Daşoguzly."]
    },
    {
      "id": "a1-u03-l03-e10",
      "type": "mcq",
      "question": "Which is spelled right?",
      "options": ["iňlis", "inlis", "iňglis"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "The sound is *ň*, the ng of “sing”.",
        "2": "No g is written or said after *ň*."
      },
      "explain": "*iňlis*: *ň* is the ng of “sing”, with no g after it."
    },
    {
      "id": "a1-u03-l03-e11",
