    {
      "id": "a1-u03-l03-e13",
      "type": "mcq",
      "points": ["gp-harmony-rounding"],
      "question": "In the guides' shorthand, what does `-lY` stand for?",
      "options": ["-ly, -li, -lu or -lü", "-la or -le", "only -ly"],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "That is `-lA`: **A** is the low vowel a or e.",
        "2": "**Y** changes with harmony: *Aşgabatly*, but *Tejenli*."
      },
      "explain": "**Y** is the high vowel: *y* or *i*, and *u* or *ü* where rounding applies."
    }
  ]
