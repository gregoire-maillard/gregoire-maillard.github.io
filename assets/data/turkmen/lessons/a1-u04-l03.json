      "type": "mcq",
      "points": ["gp-question-words"],
      "question": "How do you ask **When is the lesson?**",
      "options": ["Sapak haçan?", "Sapak haçanmy?", "Haçan sapakmy?"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "A question word needs no *-my*: it already asks.",
        "2": "With *haçan* the sentence is already a question: no *-my*."
      },
      "explain": "*Sapak haçan?* The question word sits where the answer goes: *Sapak ertir.*"
    },
