      "question": "What does Jeren do?",
      "options": ["She is a student.", "She is a teacher.", "She is a doctor."],
      "optionsLang": "en",
      "answer": 0,
      "why": {
        "1": "Myrat is the teacher: *Men mugallym*.",
        "2": "**Doctor** would be *lukman*."
      },
      "explain": "*Men talyp*: I'm a student."
