    {
      "id": "a1-u06-l01-e02",
      "type": "mcq",
      "points": ["gp-infinitive-stem"],
      "question": "What is the stem of *okamak*, to read?",
      "options": ["oka-", "okam-", "okamak", "ok-"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "Drop the whole *-mak*, not just *-ak*.",
        "2": "*okamak* is the dictionary form; endings go on the stem.",
        "3": "The *a* before *-mak* belongs to the stem: *oka-*."
      },
      "explain": "*oka-mak*: take off *-mak*, keep *oka-*."
    },
    {
      "id": "a1-u06-l01-e03",
      "type": "morph",
      "points": ["gp-present-yar", "gp-infinitive-stem"],
      "base": "okamak",
      "gloss": "I am reading",
      "parts": ["oka", "ýar", "yn"],
      "distractors": ["ýär", "in", "okam"],
      "result": "okaýaryn",
      "explain": "*oka-* + *-ýar* (back vowel *a*) + *-yn* (I): *okaýaryn*."
    },
    {
      "id": "a1-u06-l01-e04",
      "type": "conjugate",
      "points": ["gp-present-yar"],
      "base": "okamak",
      "form": "present",
      "label": "*okamak* in the present: I read, you read…",
      "cells": [
        {
          "p": "men",
          "accept": ["okaýaryn"]
        },
        {
          "p": "sen",
          "accept": ["okaýarsyň"]
        },
        {
          "p": "ol",
          "accept": ["okaýar"]
        },
        {
          "p": "biz",
          "accept": ["okaýarys"]
        },
        {
          "p": "siz",
          "accept": ["okaýarsyňyz"]
        },
        {
          "p": "olar",
          "accept": ["okaýarlar", "okaýar"]
        }
      ],
      "explain": "The last vowel of *oka-* is *a*: *-ýar*, then *-yn, -syň, —, -ys, -syňyz, -lar*."
    },
    {
