      "parts": ["mekdep", "de"],
      "distractors": ["da", "te", "mekdeb"],
      "result": "mekdepde",
      "explain": "The last vowel is *e*, a front vowel: *-de*. The *d* never changes, and the *p* of *mekdep* stays before it: *mekdepde*."
    },
