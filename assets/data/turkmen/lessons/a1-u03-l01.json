      "type": "mcq",
      "points": ["gp-personal-pronouns"],
      "question": "Which pronoun do you use for **one** person who is older than you, or whom you don't know?",
      "options": ["siz", "sen", "olar"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*sen* is for a friend, a child, or a relative your age or younger.",
        "2": "*olar* is **they**."
      },
      "explain": "*siz* is the plural **you**, and also the polite **you** for one person."
    },
    {
