    {
      "id": "a1-u04-l02-e02",
      "type": "mcq",
      "points": ["gp-question-my"],
      "question": "How do you ask **Are you tired?** (to a friend)",
      "options": ["Sen ýadawmy?", "Sen ýadaw my?", "Sen ýadawmi?", "Sen ýadawmu?"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "The particle is written onto the word: *ýadawmy*.",
        "2": "The last vowel of *ýadaw* is *a*, a back vowel, so the particle is *-my*.",
        "3": "The particle's own vowel is never *u*: *-my*."
      },
      "explain": "*ýadaw* + *-my*: one word. Your voice rises on it, as in an English question."
    },
    {
      "id": "a1-u04-l02-e03",
      "type": "morph",
      "points": ["gp-question-my"],
      "base": "täze",
      "gloss": "Is it new?",
      "parts": ["täze", "mi"],
      "distractors": ["my", "mu", "me"],
      "result": "täzemi",
      "explain": "The last vowel of *täze* is *e*, a front vowel: *-mi*. The particle's own vowel never becomes *u* or *ü*."
    },
