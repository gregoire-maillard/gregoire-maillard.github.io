  "title": "Aýna's phone",
  "goal": "Say whose something is with the genitive -(n)Yň on names, nouns and pronouns.",
  "points": ["gp-genitive", "gp-genitive-possessive"],
  "intro": {
    "text": "**Of** or **'s** is an ending: *-yň, -iň* after a consonant (*Merdanyň*), *-nyň, -niň* after a vowel (*Aýnanyň*). The thing owned takes the ending of **his** or **her**: *Aýnanyň telefony*, Aýna's phone. The pronouns: *meniň, seniň, onuň, biziň, siziň, olaryň*.",
    "see": "gp-genitive"
  },
  "vocab": [
    { "tk": "onuň", "en": "his, her, its", "pos": "pron" },
    { "tk": "biziň", "en": "our", "pos": "pron" },
    { "tk": "siziň", "en": "your (plural, or polite)", "pos": "pron" },
    { "tk": "olaryň", "en": "their", "pos": "pron" },
    { "tk": "sagat", "en": "watch, clock", "pos": "noun", "card": "fc-0160" },
    { "tk": "açar", "en": "key", "pos": "noun", "card": "fc-0691" },
    { "tk": "it", "en": "dog", "pos": "noun", "card": "fc-0417" },
