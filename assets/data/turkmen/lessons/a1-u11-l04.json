      "type": "mcq",
      "points": ["gp-ordinals"],
      "question": "How is **6th** written with digits?",
      "options": ["6-njy", "6-nji", "6njy"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*6* is said *altynjy*, with back vowels, so the ending is *-njy*.",
        "2": "A hyphen always comes between the digits and the ending: *6-njy*."
      },
      "explain": "*alty* → *altynjy*, so *6-njy*."
    },
