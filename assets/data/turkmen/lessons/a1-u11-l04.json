  "title": "Days and dates",
  "goal": "Name the days of the week, make ordinals, and say a date: on 21 March, on Monday.",
  "points": ["gp-ordinals", "gp-dates", "gp-telling-time"],
  "intro": {
    "text": "Ordinals add `-(Y)njY`: *birinji, ikinji, üçünji*; with digits *5-nji*, *6-njy*. A date is the ordinal and the month, in lowercase: *21-nji mart*; **on** that date, *21-nji martda*. **On Monday** is *duşenbe güni*.",
    "see": "gp-dates"
  },
  "vocab": [
    { "tk": "birinji", "en": "first", "pos": "num", "card": "fc-0961" },
    { "tk": "ikinji", "en": "second", "pos": "num", "card": "fc-0473" },
    { "tk": "duşenbe", "en": "Monday", "pos": "noun", "card": "fc-0600" },
    { "tk": "sişenbe", "en": "Tuesday", "pos": "noun", "card": "fc-0601" },
    { "tk": "çarşenbe", "en": "Wednesday", "pos": "noun", "card": "fc-0602" },
    { "tk": "penşenbe", "en": "Thursday", "pos": "noun", "card": "fc-0603" },
    { "tk": "anna", "en": "Friday", "pos": "noun", "card": "fc-0604" },
    { "tk": "şenbe", "en": "Saturday", "pos": "noun", "card": "fc-0606" },
    { "tk": "ýekşenbe", "en": "Sunday", "pos": "noun", "card": "fc-0607" },
    { "tk": "mart", "en": "March", "pos": "noun" },
    { "tk": "oktýabr", "en": "October", "pos": "noun" },
    { "tk": "doglan gün", "en": "birthday", "pos": "phrase", "card": "fc-0746" }
  ],
  "exercises": [
