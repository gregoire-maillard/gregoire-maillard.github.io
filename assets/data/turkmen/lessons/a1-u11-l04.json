        ["şenbe", "Saturday"]
      ]
    },
    {
      "id": "a1-u11-l04-e02",
      "type": "mcq",
      "points": ["gp-dates"],
      "question": "Which day is **Sunday**?",
      "options": ["ýekşenbe", "şenbe", "anna"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*şenbe* is Saturday.",
        "2": "*anna* is Friday."
      },
      "explain": "*ýekşenbe* is Sunday, the last day of the Turkmen week."
    },
    {
      "id": "a1-u11-l04-e03",
      "type": "mcq",
      "points": ["gp-ordinals"],
      "question": "How do you say **the second day**?",
      "options": ["ikinji gün", "iki gün", "ikiden gün"],
      "optionsLang": "tk",
      "answer": 0,
      "why": {
        "1": "*iki gün* is **two days**.",
        "2": "*ikiden* means **from two**."
      },
      "explain": "*iki* + *-nji* = *ikinji*, second."
    },
    {
      "id": "a1-u11-l04-e04",
      "type": "morph",
      "points": ["gp-ordinals", "gp-harmony-rounding"],
      "base": "dört",
      "gloss": "fourth",
      "parts": ["dörd", "ünji"],
      "distractors": ["dört", "inji", "unjy"],
      "result": "dördünji",
      "explain": "*dört* has a long vowel, so its *t* softens before a vowel; after *ö*, the ending rounds: *dördünji*."
    },
    {
      "id": "a1-u11-l04-e05",
      "type": "cloze",
      "points": ["gp-ordinals", "gp-harmony-rounding"],
      "text": "Bu meniň üç___ sapagym.",
      "en": "This is my third lesson.",
      "blanks": [
        {
          "accept": ["ünji"],
          "reject": [
            { "answer": "inji", "why": "After *ü* in the first syllable, the vowel of the ending rounds: *üçünji*." },
            { "answer": "nji", "why": "*üç* ends in a consonant, so the ordinal needs its vowel: *üçünji*." }
          ]
        }
      ],
      "explain": "*üç* + *-ünji* = *üçünji*, third."
    },
